---
import { siWhatsapp } from 'simple-icons';

interface Props {
  tamanho?: number;
}

const { tamanho = 20 } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  width={tamanho}
  height={tamanho}
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  <path d={siWhatsapp.path}></path>
</svg>

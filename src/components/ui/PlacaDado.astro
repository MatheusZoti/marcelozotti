---
// Placa de vidro com número protagonista e rótulo pequeno (ref-02 / ref-05).
interface Props {
  numero: string;
  rotulo: string;
  acesa?: boolean;
  /** conta de 0 até o número quando o bloco [data-revelar] em volta aparece (scripts/contar.ts) */
  contar?: boolean;
  /** atraso da contagem, em ms (para acompanhar a entrada da placa) */
  atrasoContagem?: number;
  class?: string;
}

const { numero, rotulo, acesa = false, contar = false, atrasoContagem = 0, class: classe } =
  Astro.props;
---

<div class:list={['placa', 'placa-dado', { 'placa--acesa': acesa }, classe]}>
  <span
    class="numero placa-dado__numero"
    data-contar={contar ? '' : undefined}
    data-contar-atraso={contar ? atrasoContagem : undefined}>{numero}</span
  >
  <span class="placa-dado__rotulo">{rotulo}</span>
</div>

<style>
  .placa-dado {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 10px;
    padding: 14px 16px 16px;
    min-height: 100px;
  }

  .placa-dado__numero {
    font-size: var(--fs-numero);
    color: var(--texto);
  }

  .placa-dado__rotulo {
    font-family: var(--fonte-mono);
    font-size: 0.75rem; /* mínimo de 12 px para rótulos */
    line-height: 1.35;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--texto-suave);
  }

  .placa--acesa .placa-dado__rotulo {
    color: color-mix(in oklab, var(--offwhite) 88%, var(--azul));
  }

  @media (min-width: 1024px) {
    .placa-dado {
      padding: 18px 20px 20px;
      min-height: 132px;
    }

    .placa-dado__rotulo {
      font-size: 0.75rem;
    }
  }
</style>

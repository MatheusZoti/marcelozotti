---
// Botão/link para o WhatsApp do Marcelo.
// variante "acao": o único foco laranja da composição, com o visual de luz (.botao-luz).
// variante "contorno": CTA secundário (cabeçalho), sem laranja.
import { linkWhatsAppPorOrigem, type OrigemCta } from '../../config/site';
import IconeWhatsApp from './IconeWhatsApp.astro';

interface Props {
  origem: OrigemCta;
  variante?: 'acao' | 'contorno';
  class?: string;
}

const { origem, variante = 'acao', class: classe } = Astro.props;
---

<a
  class:list={['botao', `botao--${variante}`, { 'botao-luz': variante === 'acao' }, classe]}
  href={linkWhatsAppPorOrigem(origem)}
  target="_blank"
  rel="noopener"
  data-cta={origem}
>
  <IconeWhatsApp tamanho={variante === 'acao' ? 22 : 18} />
  <span><slot /></span>
  <span class="visualmente-oculto">(abre o WhatsApp em uma nova aba)</span>
</a>

<style>
  .botao {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-weight: 700;
    text-decoration: none;
    border-radius: 999px;
    -webkit-tap-highlight-color: transparent;
  }

  /* visual, hover e transições vêm da classe global .botao-luz (styles/luz.css) */
  .botao--acao {
    min-height: 60px;
    padding: 0 32px;
    font-size: 1.0625rem;
  }

  .botao--contorno {
    transition: background-color var(--transicao);
    min-height: 44px;
    padding: 0 18px;
    font-size: var(--fs-pequeno);
    color: var(--texto);
    background: color-mix(in oklab, var(--offwhite) 5%, transparent);
    border: 1px solid color-mix(in oklab, var(--offwhite) 22%, transparent);
  }

  .botao--contorno:hover {
    background: color-mix(in oklab, var(--offwhite) 11%, transparent);
  }
</style>

---
// Seção 8 · Para quem é / para quem não é + pré-requisito. Luz baixa.
// "Para quem é" numa placa acesa; "para quem não é" sem placa, apagado.
// Entre as duas, as diagonais da fita (brand book, "linguagem gráfica") a 45°.
// Movimento: o título entra palavra a palavra; a placa "é para você" chega da esquerda com um
// feixe de luz e os checks se desenham; as diagonais cortam o espaço de cima para baixo e uma
// luz escorre por elas; o "não é para" chega da direita, apagado, e cada losango ganha um risco.
// O pré-requisito abre da esquerda para a direita como um destaque de marca-texto.
import { paraQuemE, paraQuemNaoE, preRequisito, titulo } from '../../conteudo/publico';

const palavras = titulo.split(' ');
---

<section class="publico" aria-labelledby="publico-titulo">
  <div class="container">
    <header data-revelar>
      <p class="rotulo rotulo-digita" style="--letras: 11">Para quem é</p>
      <h2 id="publico-titulo" class="publico__titulo">
        {
          palavras.map((palavra, i) => (
            <>
              <span class="publico__palavra" style={`--i:${i}`}>
                {palavra}
              </span>{' '}
            </>
          ))
        }
      </h2>
    </header>

    <div class="publico__colunas" data-revelar-grupo="(min-width: 900px)">
      <div class="placa placa--acesa holofote publico__sim" data-revelar>
        <span class="publico__feixe" aria-hidden="true"></span>
        <h3 class="publico__subtitulo">É para você se</h3>
        <ol class="publico__perfis" role="list">
          {
            paraQuemE.map((perfil, i) => (
              <li class="perfil" style={`--i:${i}`}>
                <span class="rotulo perfil__rotulo">
                  <span class="perfil__check" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                      <path d="M5 12.5 10 17.5 19 7" pathLength="1" />
                    </svg>
                  </span>
                  {String(i + 1).padStart(2, '0')} · {perfil.rotulo}
                </span>
                <p class="perfil__situacao">{perfil.situacao}</p>
                <p class="perfil__detalhe">{perfil.detalhe}</p>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="publico__diagonais" aria-hidden="true" data-revelar>
        <span></span>
        <span></span>
      </div>

      <div class="publico__nao" data-revelar>
        <h3 class="publico__subtitulo">Não é para</h3>
        <ul class="publico__lista" role="list">
          {paraQuemNaoE.map((item, i) => <li style={`--i:${i}`}>{item}</li>)}
        </ul>
      </div>
    </div>

    <p class="publico__requisito" data-revelar>
      <span class="rotulo publico__requisito-rotulo">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m12 3 8 4.5v9L12 21l-8-4.5v-9Z"></path><path d="m4 7.5 8 4.5 8-4.5"></path><path d="M12 12v9"></path>
        </svg>
        Pré-requisito
      </span>
      <span class="publico__requisito-texto">{preRequisito}</span>
    </p>
  </div>
</section>

<style>
  .publico {
    /* o "não é para" entra deslizando da direita: sem isso, ele empurrava a página para o lado */
    position: relative;
    overflow: clip;
    padding: 96px 0 104px;
    /* entra no tom da seção 7 e sai no da seção 10, sem emenda */
    background: linear-gradient(180deg, var(--navy-noite), var(--navy-profundo) 40%);
  }

  .publico__titulo {
    margin-top: 12px;
    max-width: 20ch;
    font-size: var(--fs-h2);
  }

  .publico__palavra {
    display: inline-block;
    animation: mov-sobe 900ms var(--saida) calc(300ms + var(--i) * 60ms) backwards;
  }

  .publico__colunas {
    display: grid;
    gap: 40px;
    margin-top: 48px;
  }

  .publico__subtitulo {
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }

  /* ---------- Para quem é ---------- */
  .publico__sim {
    position: relative;
    overflow: hidden;
    padding: 26px 22px 28px;
    transition: translate 600ms var(--saida);
    /* chega da esquerda, a placa acesa da composição */
    animation: publico-esquerda 1100ms var(--saida) var(--lote, 0ms) backwards;
  }

  /* com overflow escondido, o anel do holofote fica por dentro da borda */
  .publico__sim.holofote::before {
    inset: 0;
  }

  @keyframes publico-esquerda {
    from {
      opacity: 0;
      translate: -48px 0;
      filter: blur(10px);
    }
  }

  /* feixe a 67,5° que atravessa a placa uma vez quando ela chega */
  .publico__feixe {
    position: absolute;
    inset: -10% -40%;
    pointer-events: none;
    background: linear-gradient(
      calc(var(--desvio-luz) + 90deg),
      transparent 40%,
      color-mix(in oklab, var(--azul-luz) 26%, transparent) 50%,
      transparent 60%
    );
    translate: -100% 0;
    animation: publico-feixe 1800ms var(--saida) calc(var(--lote, 0ms) + 500ms) both;
  }

  @keyframes publico-feixe {
    to {
      translate: 100% 0;
    }
  }

  .publico__sim > .publico__subtitulo,
  .publico__sim .publico__perfis {
    position: relative;
  }

  .publico__perfis {
    display: grid;
    gap: 24px;
    margin-top: 22px;
    padding: 0;
    list-style: none;
  }

  .perfil {
    transition: translate 500ms var(--saida);
    animation: mov-sobe 900ms var(--saida) calc(var(--lote, 0ms) + 350ms + var(--i) * 160ms) backwards;
  }

  .perfil + .perfil {
    padding-top: 24px;
    border-top: 1px solid color-mix(in oklab, var(--offwhite) 14%, transparent);
  }

  .perfil__rotulo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.75rem; /* mínimo de 12 px para rótulos */
    color: color-mix(in oklab, var(--offwhite) 88%, var(--azul));
  }

  /* check que se desenha: "isto é você" */
  .perfil__check {
    display: grid;
    place-items: center;
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--azul);
    box-shadow: 0 0 14px color-mix(in oklab, var(--azul-luz) 60%, transparent);
    transition:
      scale 400ms var(--mola),
      box-shadow 400ms ease;
    animation: publico-check 600ms var(--mola) calc(var(--lote, 0ms) + 600ms + var(--i) * 160ms)
      backwards;
  }

  .perfil__check svg {
    width: 13px;
    height: 13px;
    fill: none;
    stroke: var(--offwhite);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .perfil__check path {
    stroke-dasharray: 1;
    animation: publico-traco 500ms ease-out calc(var(--lote, 0ms) + 800ms + var(--i) * 160ms)
      backwards;
  }

  @keyframes publico-check {
    from {
      scale: 0;
    }
  }

  @keyframes publico-traco {
    from {
      stroke-dashoffset: 1;
    }
  }

  @media (hover: hover) {
    .perfil:hover {
      translate: 6px 0;
    }

    .perfil:hover .perfil__check {
      scale: 1.15;
      box-shadow: 0 0 22px var(--azul-luz);
    }
  }

  .perfil__situacao {
    margin-top: 10px;
    font-size: var(--fs-lead);
    font-weight: 700;
    line-height: 1.35;
  }

  .perfil__detalhe {
    margin-top: 6px;
    font-size: var(--fs-pequeno);
    color: var(--texto-suave);
  }

  /* ---------- Diagonais da fita (divisória) ---------- */
  .publico__diagonais {
    display: flex;
    justify-content: center;
    gap: 14px;
    height: 34px;
  }

  .publico__diagonais span {
    position: relative;
    overflow: hidden;
    width: 14px;
    height: 100%;
    transform: skewX(calc(var(--ang-fita) * -1));
    transform-origin: 50% 0;
    background: var(--azul);
    border-radius: 2px;
    /* cortam o espaço de cima para baixo, uma depois da outra */
    animation: publico-corta 800ms cubic-bezier(0.7, 0, 0.3, 1) calc(var(--lote, 0ms) + 300ms)
      backwards;
  }

  .publico__diagonais span:first-child {
    background: color-mix(in oklab, var(--azul) 45%, var(--navy));
  }

  .publico__diagonais span:last-child {
    animation-delay: calc(var(--lote, 0ms) + 450ms);
  }

  @keyframes publico-corta {
    from {
      scale: 1 0;
    }
  }

  /* luz que escorre pelas diagonais, sem parar */
  .publico__diagonais span::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      transparent,
      color-mix(in oklab, var(--offwhite) 75%, transparent),
      transparent
    );
    height: 40%;
    translate: 0 -110%;
    animation: publico-escorre 3.2s ease-in-out calc(var(--lote, 0ms) + 1300ms) infinite;
  }

  .publico__diagonais span:last-child::after {
    animation-delay: calc(var(--lote, 0ms) + 1700ms);
  }

  @keyframes publico-escorre {
    0% {
      translate: 0 -110%;
    }
    45%,
    100% {
      translate: 0 260%;
    }
  }

  /* ---------- Para quem não é ---------- */
  .publico__nao {
    padding: 0 4px;
    /* chega da direita, mais devagar e apagado */
    animation: publico-direita 1100ms var(--saida) calc(var(--lote, 0ms) + 150ms) backwards;
  }

  @keyframes publico-direita {
    from {
      opacity: 0;
      translate: 40px 0;
      filter: blur(8px);
    }
  }

  .publico__nao .publico__subtitulo {
    color: var(--texto-suave);
  }

  .publico__lista {
    display: grid;
    gap: 16px;
    margin-top: 22px;
    padding: 0;
    list-style: none;
  }

  .publico__lista li {
    position: relative;
    padding-left: 28px;
    font-size: var(--fs-pequeno);
    line-height: 1.55;
    color: var(--texto-suave);
    transition: color 400ms ease;
    animation: mov-sobe 800ms var(--saida) calc(var(--lote, 0ms) + 450ms + var(--i) * 120ms)
      backwards;
  }

  /* o risco do "não": atravessa o losango depois que o item aparece */
  .publico__lista li::after {
    content: '';
    position: absolute;
    /* centrado no losango (centro em x = 7,5 px, y = 0,45em + 4,5 px) */
    left: 0;
    top: calc(0.45em + 3.75px);
    width: 15px;
    height: 1.5px;
    border-radius: 1px;
    background: var(--texto-apagado);
    rotate: -45deg;
    animation: publico-risco 450ms ease-out calc(var(--lote, 0ms) + 900ms + var(--i) * 120ms)
      backwards;
  }

  @keyframes publico-risco {
    from {
      scale: 0 1;
    }
  }

  @media (hover: hover) {
    .publico__lista li:hover {
      color: var(--texto);
    }

    .publico__lista li:hover::before {
      border-color: var(--texto-suave);
    }
  }

  /* marcador: losango vazado (a placa apagada em miniatura) */
  .publico__lista li::before {
    content: '';
    position: absolute;
    left: 3px;
    top: 0.45em;
    width: 9px;
    height: 9px;
    rotate: var(--ang-fita);
    border: 1.5px solid var(--texto-apagado);
    border-radius: 1px;
    transition: border-color 400ms ease;
  }

  /* ---------- Pré-requisito ---------- */
  .publico__requisito {
    display: grid;
    gap: 6px;
    margin-top: 40px;
    padding: 18px 20px;
    border-left: 3px solid var(--azul-luz);
    background: linear-gradient(90deg, color-mix(in oklab, var(--azul) 18%, transparent), transparent);
    /* abre da esquerda para a direita, como um marca-texto passando */
    animation: publico-marca 1100ms var(--saida) backwards;
  }

  @keyframes publico-marca {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  .publico__requisito-rotulo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--azul-luz);
    animation: mov-sobe 700ms var(--saida) 300ms backwards;
  }

  .publico__requisito-rotulo svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .publico__requisito-texto {
    font-size: var(--fs-lead);
    font-weight: 700;
    animation: mov-sobe 800ms var(--saida) 420ms backwards;
  }

  @media (min-width: 900px) {
    .publico {
      padding: 128px 0;
    }

    .publico__colunas {
      grid-template-columns: minmax(0, 1.15fr) auto minmax(0, 1fr);
      align-items: center;
      gap: 48px;
      margin-top: 64px;
    }

    .publico__sim {
      padding: 36px 34px 38px;
    }

    .publico__diagonais {
      height: 120px;
      gap: 18px;
    }

    .publico__diagonais span {
      width: 16px;
    }

    .publico__requisito {
      grid-template-columns: auto 1fr;
      align-items: baseline;
      gap: 20px;
      margin-top: 56px;
      padding: 22px 28px;
    }
  }
</style>

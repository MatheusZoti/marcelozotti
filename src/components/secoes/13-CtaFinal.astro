---
// Seção 13 · CTA final com qualificador (ref-04): colunas de luz a 67,5° atrás do conteúdo.
// Luz máxima, segundo pico da página. As escolhas montam a mensagem do WhatsApp;
// sem JavaScript, o botão envia a mensagem padrão. Nada é obrigatório.
import { apoio, perguntas, titulo } from '../../conteudo/cta-final';
import BotaoWhatsApp from '../ui/BotaoWhatsApp.astro';
---

<section class="final" aria-labelledby="final-titulo" id="conversar" data-final>
  <div class="final__luz" aria-hidden="true">
    <div class="final__colunas"></div>
  </div>

  <div class="container final__grade">
    <div class="final__texto">
      <p class="rotulo">O próximo passo</p>
      <h2 id="final-titulo" class="final__titulo">{titulo}</h2>
      <p class="final__apoio">{apoio}</p>
    </div>

    <form class="placa final__painel" action="#" onsubmit="return false">
      <p class="final__instrucao">
        Responda se quiser. As respostas vão junto na mensagem e ajudam o Marcelo a entender o seu
        momento.
      </p>

      {
        perguntas.map((p) => (
          <fieldset class="final__pergunta">
            <legend class="final__legenda">{p.pergunta}</legend>
            <div class="final__opcoes">
              {p.opcoes.map((o) => (
                <label class="opcao">
                  <input
                    class="visualmente-oculto"
                    type="radio"
                    name={p.id}
                    value={o.valor}
                    data-linha={`${p.naMensagem}: ${o.naMensagem}`}
                  />
                  <span>{o.rotulo}</span>
                </label>
              ))}
            </div>
          </fieldset>
        ))
      }

      <BotaoWhatsApp origem="final" class="final__botao">Enviar para o Marcelo</BotaoWhatsApp>
    </form>
  </div>
</section>

<script>
  import { linkWhatsApp, MENSAGENS_WHATSAPP } from '../../config/site';

  const secao = document.querySelector<HTMLElement>('[data-final]');
  const botao = secao?.querySelector<HTMLAnchorElement>('a[data-cta="final"]');

  if (secao && botao) {
    const atualizar = () => {
      const linhas = [...secao.querySelectorAll<HTMLInputElement>('input[type="radio"]:checked')].map(
        (escolha) => `• ${escolha.dataset.linha}`,
      );
      const mensagem = linhas.length
        ? [MENSAGENS_WHATSAPP.final, ...linhas].join('\n')
        : MENSAGENS_WHATSAPP.final;
      botao.href = linkWhatsApp(mensagem);
    };

    secao.addEventListener('change', atualizar);
    atualizar(); // o navegador pode restaurar escolhas ao voltar para a página
  }
</script>

<style>
  .final {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding: 104px 0 112px;
    background: var(--navy-noite);
  }

  /* ---------- Colunas de luz (ref-04), inclinadas a 67,5° ---------- */
  .final__luz {
    position: absolute;
    inset: 0;
    z-index: -1;
    mask-image: linear-gradient(180deg, transparent 0%, #000 22%, #000 78%, transparent 100%);
  }

  .final__colunas {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 170%;
    height: 170%;
    translate: -50% -50%;
    rotate: var(--desvio-luz);
    /* faixas de larguras e intensidades diferentes, como na ref-04 */
    background: linear-gradient(
      90deg,
      transparent 0% 16%,
      color-mix(in oklab, var(--azul) 14%, transparent) 19%,
      transparent 23%,
      color-mix(in oklab, var(--azul) 26%, transparent) 27%,
      color-mix(in oklab, var(--azul) 48%, transparent) 31%,
      color-mix(in oklab, var(--azul) 22%, transparent) 34%,
      color-mix(in oklab, var(--azul) 58%, transparent) 38%,
      color-mix(in oklab, var(--azul-luz) 62%, transparent) 41%,
      color-mix(in oklab, var(--azul) 46%, transparent) 44%,
      color-mix(in oklab, var(--azul) 18%, transparent) 47%,
      color-mix(in oklab, var(--azul) 40%, transparent) 51%,
      color-mix(in oklab, var(--azul) 12%, transparent) 55%,
      transparent 58%,
      color-mix(in oklab, var(--azul) 20%, transparent) 62%,
      transparent 66% 100%
    );
    filter: blur(8px);
    animation: colunas-deslizam 24s ease-in-out infinite alternate;
  }

  @keyframes colunas-deslizam {
    from {
      translate: -52% -50%;
    }
    to {
      translate: -46% -50%;
    }
  }

  /* ---------- Conteúdo ---------- */
  .final__grade {
    display: grid;
    gap: 40px;
  }

  .final__titulo {
    margin-top: 12px;
    font-size: clamp(2rem, 1.3rem + 3vw, 3.5rem);
    letter-spacing: -0.035em;
  }

  .final__apoio {
    margin-top: 18px;
    max-width: 30rem;
    font-size: var(--fs-lead);
    color: var(--texto-suave);
  }

  /* ---------- Painel do qualificador ---------- */
  .final__painel {
    display: grid;
    gap: 22px;
    padding: 22px 18px 24px;
    --placa-opacidade: 80%;
  }

  .final__instrucao {
    font-size: var(--fs-pequeno);
    color: var(--texto-suave);
  }

  .final__pergunta {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .final__legenda {
    padding: 0;
    margin-bottom: 10px;
    font-weight: 700;
  }

  .final__opcoes {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .opcao {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid color-mix(in oklab, var(--offwhite) 20%, transparent);
    background: color-mix(in oklab, var(--offwhite) 4%, transparent);
    font-size: var(--fs-pequeno);
    font-weight: 600;
    line-height: 1.3;
    color: var(--texto-suave);
    cursor: pointer;
    transition:
      background-color var(--transicao),
      border-color var(--transicao),
      color var(--transicao);
    -webkit-tap-highlight-color: transparent;
  }

  .opcao:hover {
    border-color: color-mix(in oklab, var(--azul-fio) 60%, transparent);
  }

  .opcao:has(input:checked) {
    background: var(--azul);
    border-color: var(--azul);
    color: var(--offwhite);
  }

  .opcao:has(input:focus-visible) {
    outline: 2px solid var(--azul-fio);
    outline-offset: 2px;
  }

  .final__painel :global(.final__botao) {
    width: 100%;
    margin-top: 4px;
  }

  @media (min-width: 1024px) {
    .final {
      padding: 152px 0 160px;
    }

    .final__grade {
      grid-template-columns: minmax(0, 1fr) minmax(0, 30rem);
      gap: 72px;
      align-items: center;
    }

    .final__painel {
      padding: 32px 30px 32px;
      --placa-opacidade: 60%;
    }
  }
</style>

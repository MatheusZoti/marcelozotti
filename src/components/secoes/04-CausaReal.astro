---
// Seção 4 · A causa real (ref-03): título grande, gráfico em cascata e conclusão com barra lateral.
// A troca entre "preço cheio" e "com desconto" é feita só com CSS (funciona sem JavaScript).
// Luz baixa: a foto P&B da operação aparece como textura escura no topo.
// Movimento: o gráfico se monta como uma cascata de verdade (o preço sobe, cada saída cai do
// alto e quica no lugar, a sobra cresce e acende). Na troca de cenário as barras escorregam em
// onda, os valores viram e um selo mostra quanto da sobra some. Hover destaca uma barra.
import { Image } from 'astro:assets';
import fotoOperacao from '../../assets/fotos/operacao-pb.jpg';
import { cenarios, formatarReais, quedaDaSobra } from '../../conteudo/causa';

const [cheio, desconto] = cenarios;

// junta as parcelas dos dois cenários pela posição
const parcelas = cheio.parcelas.map((parcela, i) => ({
  ...parcela,
  b: desconto.parcelas[i],
}));
---

<section class="causa" aria-labelledby="causa-titulo">
  <div class="causa__fundo" aria-hidden="true" data-revelar>
    <Image
      src={fotoOperacao}
      alt=""
      widths={[640, 960, 1280]}
      sizes="100vw"
      quality={55}
      loading="lazy"
    />
  </div>

  <div class="container">
    <header class="causa__topo" data-revelar>
      <p class="rotulo rotulo-digita" style="--letras: 12">A causa real</p>
      <h2 id="causa-titulo" class="causa__titulo">
        <span class="causa__titulo-base">Não é falta de esforço.</span>
        <span class="causa__titulo-luz">É falta de método.</span>
      </h2>
      <p class="causa__texto">
        Quem vende em marketplace costuma trabalhar muito: responde cliente, ajusta anúncio, acompanha
        concorrente. O que falta quase sempre é uma forma de decidir: saber quanto custa cada venda,
        qual preço fecha a conta e onde vale investir.
      </p>
    </header>

    <div class="causa__painel">
      <div class="causa__painel-topo" data-revelar>
        <h3 class="causa__painel-titulo">
          Não baixe o seu preço antes de fazer esta conta.
        </h3>

        <fieldset class="causa__cenarios">
          <legend class="visualmente-oculto">Escolha o cenário do exemplo</legend>
          {
            cenarios.map((cenario) => (
              <label class="causa__cenario">
                <input
                  class="visualmente-oculto"
                  type="radio"
                  name="cenario"
                  value={cenario.id}
                  checked={cenario.id === 'cheio'}
                />
                <span>{cenario.rotulo}</span>
                <span class="numero">R$ {cenario.preco}</span>
              </label>
            ))
          }
        </fieldset>
      </div>

      <ol class="cascata" data-revelar aria-label="De onde sai cada real de uma venda (exemplo ilustrativo)">
        {
          parcelas.map((p, i) => (
            <li
              class={`barra barra--${p.tipo}`}
              style={`--i:${i};--ini-a:${p.ini};--fim-a:${p.fim};--ini-b:${p.b.ini};--fim-b:${p.b.fim}`}
            >
              <span class="barra__nome">{p.nome}</span>
              <span class="barra__valor numero">
                {p.tipo === 'sobra' && (
                  <span class="barra__queda" aria-hidden="true">
                    −{quedaDaSobra}%
                  </span>
                )}
                <span class="so-a">{formatarReais(p.valor)}</span>
                <span class="so-b">{formatarReais(p.b.valor)}</span>
              </span>
              <span class="barra__trilho" aria-hidden="true">
                <span class="barra__preenchimento" />
              </span>
            </li>
          ))
        }
      </ol>

      <div class="causa__conclusao" data-revelar>
        <p class="causa__sobra">
          <span class="so-a">
            De cada venda de R$ {cheio.preco}, sobram
            <strong class="numero">{formatarReais(cheio.sobra)}</strong>.
          </span>
          <span class="so-b">
            Com 10% de desconto, de cada venda de R$ {desconto.preco} sobram
            <strong class="numero">{formatarReais(desconto.sobra)}</strong>.
          </span>
        </p>
        <p class="causa__licao">
          10% a menos no preço pode significar {quedaDaSobra}% a menos de sobra. Método é fazer essa
          conta antes de decidir, e não depois.
        </p>
      </div>

      <p class="causa__aviso" data-revelar>
        Exemplo ilustrativo com números redondos. Comissões, frete e impostos variam por marketplace,
        categoria e regime tributário. Na mentoria, a conta é feita com os números da sua operação.
      </p>
    </div>
  </div>
</section>

<style>
  .causa {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding: 96px 0 104px;
    background: linear-gradient(180deg, var(--navy-noite), var(--navy-profundo) 40%);
  }

  /* textura: foto P&B da operação, bem escura, só no topo */
  .causa__fundo {
    position: absolute;
    inset: 0 0 auto;
    height: 640px;
    z-index: -1;
    opacity: 0.16;
    mask-image: linear-gradient(180deg, transparent 0%, #000 25%, #000 45%, transparent 100%);
  }

  .causa__fundo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* a foto "revela" do escuro, como uma lembrança da operação */
    animation: causa-foto 2400ms var(--saida) backwards;
  }

  @keyframes causa-foto {
    from {
      opacity: 0;
      scale: 1.1;
      filter: blur(6px);
    }
  }

  /* ---------- Topo (ref-03: título gigante + texto ao lado) ---------- */
  .causa__titulo {
    margin-top: 12px;
    font-size: clamp(2.25rem, 1.3rem + 4.4vw, 4.75rem);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .causa__titulo-base,
  .causa__titulo-luz {
    display: block;
  }

  .causa__titulo-luz {
    color: var(--azul-luz);
  }

  /* ---------- Entrada do topo ---------- */
  .causa__titulo-base {
    animation: mov-sobe 1000ms var(--saida) 360ms backwards;
  }

  .causa__titulo-luz {
    animation: mov-varredura 1500ms var(--saida) 620ms backwards;
  }

  .causa__texto {
    margin-top: 24px;
    max-width: 34rem;
    font-size: var(--fs-lead);
    color: var(--texto-suave);
    animation: mov-sobe 1000ms var(--saida) 860ms backwards;
  }

  .causa__painel-titulo {
    animation: mov-sobe 900ms var(--saida) backwards;
  }

  .causa__cenarios {
    animation: mov-sobe 900ms var(--saida) 150ms backwards;
  }

  /* ---------- Painel do gráfico ---------- */
  .causa__painel {
    margin-top: 56px;
  }

  .causa__painel-topo {
    display: grid;
    gap: 20px;
    margin-bottom: 32px;
  }

  .causa__painel-titulo {
    max-width: 30rem;
    font-size: clamp(1.25rem, 1.1rem + 0.7vw, 1.625rem);
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  /* seletor de cenário */
  .causa__cenarios {
    position: relative;
    display: inline-grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
    padding: 4px;
    margin: 0;
    border: 1px solid color-mix(in oklab, var(--offwhite) 12%, transparent);
    border-radius: 16px;
    background: color-mix(in oklab, var(--navy) 70%, transparent);
    min-width: 0;
  }

  /* peça azul que desliza até o cenário escolhido */
  .causa__cenarios::before {
    content: '';
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 4px;
    width: calc((100% - 12px) / 2);
    border-radius: 12px;
    background: linear-gradient(
      180deg,
      color-mix(in oklab, var(--azul) 70%, var(--offwhite) 8%),
      var(--azul)
    );
    box-shadow:
      inset 0 1px 0 color-mix(in oklab, var(--offwhite) 35%, transparent),
      0 6px 20px color-mix(in oklab, var(--azul) 45%, transparent);
    transition: translate 600ms var(--saida);
  }

  .causa__cenarios:has(input[value='desconto']:checked)::before {
    translate: calc(100% + 4px) 0;
  }

  .causa__cenario {
    position: relative; /* acima da peça */
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 14px;
    border-radius: 12px;
    font-size: var(--fs-pequeno);
    font-weight: 600;
    color: var(--texto-suave);
    cursor: pointer;
    transition:
      background-color var(--transicao),
      color var(--transicao);
  }

  .causa__cenario .numero {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .causa__cenario:has(input:checked) {
    color: var(--offwhite);
  }

  @media (hover: hover) {
    .causa__cenario:not(:has(input:checked)):hover {
      color: var(--offwhite);
    }
  }

  .causa__cenario:has(input:focus-visible) {
    outline: 2px solid var(--azul-fio);
    outline-offset: 2px;
  }

  /* troca de cenário só com CSS */
  .so-b {
    display: none;
  }

  .causa:has(input[value='desconto']:checked) .so-a {
    display: none;
  }

  .causa:has(input[value='desconto']:checked) .so-b {
    display: inline;
  }

  /* o valor novo "vira" no lugar (a regra volta a valer a cada troca, então a animação repete) */
  .causa:has(input[value='cheio']:checked) .so-a,
  .causa:has(input[value='desconto']:checked) .so-b {
    display: inline-block;
    animation: causa-vira 520ms var(--saida) calc(var(--i, 0) * 60ms) backwards;
  }

  /* na frase da conclusão o texto continua em linha (inline-block quebraria a frase) */
  .causa:has(input[value='cheio']:checked) .causa__sobra .so-a,
  .causa:has(input[value='desconto']:checked) .causa__sobra .so-b {
    display: inline;
  }

  .causa:has(input[value='desconto']:checked) .causa__sobra .so-a,
  .causa:has(input[value='cheio']:checked) .causa__sobra .so-b {
    display: none;
  }

  @keyframes causa-vira {
    from {
      opacity: 0;
      translate: 0 -0.5em;
      filter: blur(4px);
    }
  }

  .barra {
    --ini: var(--ini-a);
    --fim: var(--fim-a);
  }

  .causa:has(input[value='desconto']:checked) .barra {
    --ini: var(--ini-b);
    --fim: var(--fim-b);
  }

  /* ---------- Cascata: barras horizontais no celular ---------- */
  .cascata {
    /* direção da montagem: no celular as saídas chegam da direita e as barras crescem da esquerda */
    --barra-de: 40px 0;
    --cresce-de: 0 1;
    --origem: left center;
    display: grid;
    gap: 18px;
    padding: 0;
    list-style: none;
  }

  .barra {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'nome valor'
      'trilho trilho';
    gap: 8px 12px;
    align-items: baseline;
  }

  .barra__nome {
    grid-area: nome;
    font-family: var(--fonte-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--texto-suave);
  }

  .barra__valor {
    grid-area: valor;
    font-size: 0.9375rem;
    color: var(--texto);
  }

  .barra__trilho {
    grid-area: trilho;
    position: relative;
    height: 14px;
    border-radius: 4px;
    background: color-mix(in oklab, var(--navy) 80%, transparent);
    overflow: hidden;
  }

  .barra__preenchimento {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--ini) * 1%);
    width: calc((var(--fim) - var(--ini)) * 1%);
    border-radius: 4px;
    transform-origin: var(--origem);
    /* troca de cenário: as barras escorregam em onda, da primeira à última */
    transition:
      left 800ms var(--saida),
      width 800ms var(--saida),
      bottom 800ms var(--saida),
      height 800ms var(--saida),
      filter 300ms ease;
    transition-delay: calc(var(--i) * 70ms);
    /* entrada: cada saída cai do alto e quica no lugar, uma depois da outra */
    animation: causa-cai 900ms var(--mola) calc(250ms + var(--i) * 170ms) backwards;
  }

  @keyframes causa-cai {
    from {
      opacity: 0;
      translate: var(--barra-de);
    }
  }

  /* preço e sobra crescem a partir da base */
  .barra--total .barra__preenchimento {
    animation-name: causa-cresce;
    animation-timing-function: var(--saida);
  }

  /* a sobra cresce por último e acende, para o olho parar nela */
  .barra--sobra .barra__preenchimento {
    animation:
      causa-cresce 1000ms var(--saida) calc(250ms + var(--i) * 170ms) backwards,
      causa-acende 1600ms ease calc(1000ms + var(--i) * 170ms);
  }

  @keyframes causa-cresce {
    from {
      scale: var(--cresce-de);
    }
  }

  @keyframes causa-acende {
    30% {
      box-shadow:
        0 0 46px 8px var(--azul-luz),
        0 0 18px var(--azul-luz);
      filter: brightness(1.35);
    }
  }

  .barra__valor {
    animation: mov-sobe 700ms var(--saida) calc(450ms + var(--i) * 170ms) backwards;
  }

  .barra__nome {
    animation: mov-aparece 700ms ease calc(350ms + var(--i) * 170ms) backwards;
  }

  /* selo: quanto da sobra some com o desconto (só no cenário com desconto) */
  .barra__queda {
    display: none;
    margin-right: 8px;
    padding: 2px 8px;
    border-radius: 999px;
    border: 1px solid var(--azul-fio);
    background: color-mix(in oklab, var(--azul) 28%, transparent);
    font-size: 0.75rem;
    color: var(--offwhite);
    vertical-align: 0.1em;
  }

  .causa:has(input[value='desconto']:checked) .barra__queda {
    display: inline-block;
    animation: causa-selo 700ms var(--mola) 450ms backwards;
  }

  @keyframes causa-selo {
    from {
      opacity: 0;
      scale: 0.4;
      translate: 0 8px;
    }
  }

  /* total: azul que clareia (gradiente da ref-03, sem o rosa) */
  .barra--total .barra__preenchimento {
    background: linear-gradient(90deg, var(--azul), var(--azul-luz));
  }

  /* saídas: o dinheiro que vai embora, em azul apagado */
  .barra--saida .barra__preenchimento {
    background: color-mix(in oklab, var(--azul) 52%, var(--navy));
  }

  .barra--saida .barra__valor {
    color: var(--texto-suave);
  }

  /* sobra: a peça acesa da composição; o número é o único foco laranja */
  .barra--sobra .barra__nome {
    color: var(--texto);
  }

  .barra--sobra .barra__preenchimento {
    background: linear-gradient(90deg, var(--azul-luz), var(--offwhite));
    box-shadow: 0 0 18px var(--azul-luz);
  }

  .barra--sobra .barra__valor,
  .causa__sobra strong {
    color: var(--laranja);
  }

  /* ---------- Conclusão (barra lateral, como a "Conclusión" da ref-03) ---------- */
  .causa__conclusao,
  .causa__aviso {
    /* se entrar junto com o gráfico (mesmo lote), espera a cascata terminar de montar */
    --depois: calc(var(--lote, 0ms) * 7);
  }

  .causa__conclusao {
    position: relative;
    margin-top: 40px;
    padding-left: 18px;
  }

  /* barra lateral que se desenha de cima para baixo antes do texto */
  .causa__conclusao::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: linear-gradient(180deg, var(--azul-luz), transparent);
    box-shadow: 0 0 12px color-mix(in oklab, var(--azul-luz) 50%, transparent);
    transform-origin: top;
    animation: causa-linha 900ms var(--saida) var(--depois) backwards;
  }

  @keyframes causa-linha {
    from {
      scale: 1 0;
    }
  }

  .causa__sobra {
    animation: mov-sobe 900ms var(--saida) calc(var(--depois) + 200ms) backwards;
  }

  .causa__licao {
    animation: mov-sobe 900ms var(--saida) calc(var(--depois) + 340ms) backwards;
  }

  .causa__aviso {
    animation: mov-aparece 1200ms ease calc(var(--depois) + 200ms) backwards;
  }

  .causa__sobra {
    font-size: var(--fs-lead);
    font-weight: 700;
  }

  .causa__sobra strong {
    font-weight: 600;
  }

  .causa__licao {
    margin-top: 8px;
    max-width: 38rem;
    color: var(--texto-suave);
  }

  .causa__aviso {
    margin-top: 28px;
    max-width: 44rem;
    font-size: 0.8125rem;
    color: var(--texto-apagado);
  }

  @media (min-width: 560px) {
    .causa__cenarios {
      justify-self: start;
    }
  }

  /* ---------- Telas largas: colunas verticais como na ref-03 ---------- */
  @media (min-width: 900px) {
    .causa {
      padding: 128px 0;
    }

    .causa__topo {
      display: grid;
      grid-template-columns: auto minmax(0, 24rem);
      grid-template-areas:
        'rotulo rotulo'
        'titulo texto';
      column-gap: 56px;
      align-items: end;
    }

    .causa__topo .rotulo {
      grid-area: rotulo;
    }

    .causa__titulo {
      grid-area: titulo;
    }

    .causa__texto {
      grid-area: texto;
      margin-top: 0;
      font-size: var(--fs-corpo);
    }

    .causa__painel {
      margin-top: 80px;
    }

    .causa__painel-topo {
      grid-template-columns: 1fr auto;
      align-items: end;
      margin-bottom: 48px;
    }

    .cascata {
      grid-template-columns: repeat(6, 1fr);
      gap: 16px;
      align-items: end;
      padding-top: 8px;
      border-bottom: 1px solid color-mix(in oklab, var(--offwhite) 30%, transparent);
    }

    .barra {
      grid-template-columns: 1fr;
      grid-template-areas:
        'valor'
        'trilho'
        'nome';
      gap: 12px;
      text-align: center;
    }

    .barra__valor {
      font-size: 1.125rem;
    }

    .barra__trilho {
      height: clamp(240px, 26vw, 340px);
      border-radius: 6px 6px 0 0;
    }

    .cascata {
      --barra-de: 0 -56px;
      --cresce-de: 1 0;
      --origem: center bottom;
    }

    .barra__preenchimento {
      left: 0;
      right: 0;
      width: auto;
      top: auto;
      bottom: calc(var(--ini) * 1%);
      height: calc((var(--fim) - var(--ini)) * 1%);
      border-radius: 6px 6px 0 0;
    }

    .barra--total .barra__preenchimento {
      background: linear-gradient(0deg, var(--azul-luz), var(--azul) 70%);
    }

    .barra--sobra .barra__preenchimento {
      background: linear-gradient(0deg, var(--offwhite), var(--azul-luz));
    }

    .barra__nome {
      order: 3;
      min-height: 2.6em;
      padding-top: 4px;
      font-size: 0.75rem; /* mínimo de 12 px para rótulos */
    }

    .barra--sobra .barra__valor {
      font-size: 1.375rem;
    }

    .barra__queda {
      display: none;
      width: max-content;
      margin: 0 auto 8px;
    }

    .causa:has(input[value='desconto']:checked) .barra__queda {
      display: block;
    }

    /* hover: a barra apontada acende e as outras recuam (foco no número que importa) */
    .barra {
      transition: opacity 350ms ease;
    }

    @media (hover: hover) {
      .cascata:has(.barra:hover) .barra:not(:hover) {
        opacity: 0.38;
      }

      .barra:hover .barra__preenchimento {
        filter: brightness(1.3) saturate(1.1);
      }

      .barra:hover .barra__nome {
        color: var(--offwhite);
      }
    }

    .causa__conclusao {
      margin-top: 48px;
    }
  }

  @media (min-width: 1280px) {
    .cascata {
      gap: 24px;
    }
  }
</style>

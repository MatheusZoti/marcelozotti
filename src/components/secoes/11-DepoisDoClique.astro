---
// Seção 11 · Como funciona depois do clique. Luz baixa.
// Desktop: os 3 passos sobem em escada e uma linha os liga com trechos horizontais e
// subidas a 45° (o desenho do Z do símbolo). As medidas da escada são em % da largura,
// então o SVG (que mantém a proporção) acompanha em qualquer tela e o ângulo fica em 45°.
// Celular: linha vertical simples.
import { passos, semCompromisso, titulo } from '../../conteudo/depois-do-clique';
---

<section class="clique" aria-labelledby="clique-titulo">
  <div class="container">
    <header>
      <p class="rotulo">Como funciona depois do clique</p>
      <h2 id="clique-titulo" class="clique__titulo">{titulo}</h2>
    </header>

    <div class="clique__trilha">
      <svg
        class="clique__linha"
        viewBox="0 0 1000 130"
        aria-hidden="true"
        focusable="false"
      >
        <defs>
          <linearGradient id="clique-fita" x1="0" x2="1" y1="0" y2="0">
            <stop offset="0" stop-color="#2563EB" stop-opacity="0.35"></stop>
            <stop offset="0.7" stop-color="#2563EB"></stop>
            <stop offset="1" stop-color="#93B0F5"></stop>
          </linearGradient>
        </defs>
        <!-- marcadores em x = 0 / 346,67 / 693,33 e y = 110 / 60 / 10; cada subida tem 50 × 50 (45°) -->
        <path
          d="M0 110 H256.67 L306.67 60 H603.33 L653.33 10 H760"
          fill="none"
          stroke="url(#clique-fita)"
          stroke-width="2"
          vector-effect="non-scaling-stroke"></path>
      </svg>

      <ol class="clique__passos" role="list">
        {
          passos.map((passo, i) => (
            <li class="passo-clique">
              <span class="passo-clique__marca" aria-hidden="true" />
              <span class="numero passo-clique__numero">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="passo-clique__titulo">{passo.titulo}</h3>
              <p class="passo-clique__texto">{passo.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>

    <p class="clique__nota">{semCompromisso}</p>
  </div>
</section>

<style>
  .clique {
    position: relative;
    padding: 96px 0 104px;
    background:
      radial-gradient(50% 45% at 85% 20%, color-mix(in oklab, var(--azul) 16%, transparent), transparent 70%),
      var(--navy-noite);
  }

  .clique__titulo {
    margin-top: 12px;
    font-size: var(--fs-h2);
  }

  /* ---------- Celular: trilha vertical ---------- */
  .clique__trilha {
    position: relative;
    margin-top: 48px;
  }

  .clique__linha {
    display: none;
  }

  .clique__passos {
    display: grid;
    gap: 36px;
    padding: 0 0 0 30px;
    list-style: none;
    border-left: 2px solid;
    border-image: linear-gradient(180deg, color-mix(in oklab, var(--azul) 40%, transparent), var(--azul-luz)) 1;
    margin-left: 7px;
  }

  .passo-clique {
    position: relative;
  }

  /* losango a 45° sobre a linha */
  .passo-clique__marca {
    position: absolute;
    left: -38px;
    top: 0.55rem;
    width: 12px;
    height: 12px;
    rotate: var(--ang-fita);
    background: var(--azul-luz);
    box-shadow: 0 0 12px var(--azul);
    border-radius: 1px;
  }

  .passo-clique__numero {
    font-size: 1.75rem;
    color: var(--azul-luz);
  }

  .passo-clique__titulo {
    margin-top: 10px;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }

  .passo-clique__texto {
    margin-top: 6px;
    max-width: 30rem;
    color: var(--texto-suave);
  }

  .clique__nota {
    margin-top: 48px;
    font-family: var(--fonte-mono);
    font-size: 0.8125rem;
    color: var(--texto-suave);
  }

  /* ---------- Desktop: escada a 45° ---------- */
  @media (min-width: 900px) {
    .clique {
      padding: 128px 0 120px;
    }

    .clique__trilha {
      margin-top: 72px;
    }

    .clique__linha {
      display: block;
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: auto;
      /* y = 10 do viewBox cai no topo da trilha (margens em % usam a largura) */
      margin-top: -1%;
      overflow: visible;
    }

    .clique__passos {
      display: flex;
      align-items: flex-start;
      gap: 0;
      padding: 0;
      margin: 0;
      border: 0;
    }

    /* larguras e degraus em % da largura da trilha: 30,667% + 4% de espaço; degrau de 5% */
    .passo-clique {
      width: 30.667%;
      padding-top: 30px;
    }

    .passo-clique + .passo-clique {
      margin-left: 4%;
    }

    .passo-clique:nth-child(1) {
      margin-top: 10%;
    }

    .passo-clique:nth-child(2) {
      margin-top: 5%;
    }

    .passo-clique__marca {
      left: 0;
      top: 0;
      translate: -50% -50%;
    }

    .passo-clique:last-child .passo-clique__marca {
      width: 16px;
      height: 16px;
      background: var(--offwhite);
      box-shadow: 0 0 18px var(--azul-luz);
    }

    .passo-clique__numero {
      font-size: 2.25rem;
    }

    .clique__nota {
      margin-top: 56px;
    }
  }
</style>

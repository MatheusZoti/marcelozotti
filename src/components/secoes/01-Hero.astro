---
// Seção 1 · Hero (ref-01): Marcelo na placa central, sob um feixe de luz a 67,5°,
// com placas de dados reais do formato orbitando. Luz no máximo.
// Entrada (≈ 1,8 s): o feixe acende de cima, a foto é revelada por um corte a 67,5°, o título
// sobe palavra a palavra, a frase azul é varrida pela luz e as placas entram em órbita contando.
// Depois: poeira flutuando no feixe e, com mouse, a cena inteira reage ao ponteiro (profundidade).
// Tudo em CSS (o conteúdo aparece mesmo sem JavaScript); o JS só soma contagem e paralaxe.
import { Picture } from 'astro:assets';
import fotoHero from '../../assets/fotos/hero-marcelo-galpao.jpg';
import BotaoWhatsApp from '../ui/BotaoWhatsApp.astro';
import PlacaDado from '../ui/PlacaDado.astro';

const provas = [
  'Fundador da Brazotti Distribuidora',
  'Online para todo o Brasil',
  'Presencial em Curitiba e região',
];

const tituloBase = 'Transforme seus produtos'.split(' ');
const tituloLuz = 'em vendas nos marketplaces.';

// poeira no feixe: posições fixas (sorteio com semente), iguais em todo build
let semente = 11;
const sortear = () => (semente = (semente * 9301 + 49297) % 233280) / 233280;
const poeira = Array.from({ length: 16 }, () => ({
  x: `${(sortear() * 100).toFixed(1)}%`,
  atraso: `${(-sortear() * 18).toFixed(2)}s`,
  duracao: `${(12 + sortear() * 10).toFixed(2)}s`,
  tamanho: `${(1.5 + sortear() * 2.2).toFixed(1)}px`,
  brilho: (0.3 + sortear() * 0.55).toFixed(2),
  deriva: `${((sortear() - 0.5) * 60).toFixed(0)}px`,
}));

const dados = [
  { numero: '6+', rotulo: 'anos vendendo em marketplaces', acesa: true },
  { numero: '4', rotulo: 'encontros individuais' },
  { numero: '8h', rotulo: 'de mentoria ao vivo' },
  { numero: '~30', rotulo: 'dias de acompanhamento', acesa: true },
];
---

<section class="hero" aria-labelledby="hero-titulo" data-hero>
  <div class="hero__luz" aria-hidden="true">
    <div class="feixe hero__feixe"></div>
    <div class="hero__poeira">
      {
        poeira.map((p) => (
          <i
            style={`--x:${p.x};--atraso:${p.atraso};--duracao:${p.duracao};--tamanho:${p.tamanho};--brilho:${p.brilho};--deriva:${p.deriva}`}
          />
        ))
      }
    </div>
    <div class="hero__brilho"></div>
  </div>

  <div class="container hero__grade">
    <div class="hero__texto">
      <p class="rotulo hero__selo">Mentoria individual · Mercado Livre e Shopee</p>

      <h1 id="hero-titulo" class="hero__titulo">
        <span class="hero__titulo-base">
          {
            tituloBase.map((palavra, i) => (
              <>
                <span class="hero__palavra" style={`--i:${i}`}>
                  {palavra}
                </span>{' '}
              </>
            ))
          }
        </span>
        <span class="hero__titulo-luz">{tituloLuz}</span>
      </h1>

      <p class="hero__lead">
        Estratégia e acompanhamento de quem vive o marketplace todos os dias, mesmo que você ainda
        não venda online.
      </p>

      <div class="hero__acao">
        <BotaoWhatsApp origem="hero">Quero conversar com o Marcelo</BotaoWhatsApp>
      </div>

      <ul class="hero__provas" role="list">
        {provas.map((prova, i) => <li style={`--i:${i}`}>{prova}</li>)}
      </ul>
    </div>

    <div class="hero__palco">
      <figure class="placa placa--acesa hero__foto">
        <Picture
          src={fotoHero}
          formats={['avif', 'webp']}
          widths={[360, 540, 720, 960]}
          sizes="(min-width: 1024px) 400px, 86vw"
          alt="Marcelo Zotti explicando, de camiseta azul, no galpão da operação da Brazotti Distribuidora"
          loading="eager"
          fetchpriority="high"
        />
      </figure>

      <div class="hero__dados">
        {
          dados.map((dado, i) => (
            <div class={`hero__orbita hero__orbita--${i + 1}`} style={`--i:${i}`}>
              <PlacaDado
                class="hero__dado"
                numero={dado.numero}
                rotulo={dado.rotulo}
                acesa={dado.acesa}
              />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const calmo = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (hero && !calmo) {
    // ---------- Celular: foto e placas ficam abaixo da dobra, então só entram quando aparecem ----------
    if (window.matchMedia('(max-width: 1023px)').matches && 'IntersectionObserver' in window) {
      const esperando = new Set<HTMLElement>();
      const liberar = (el: HTMLElement) => {
        delete el.dataset.espera;
        esperando.delete(el);
        observador.unobserve(el);
        if (!esperando.size) window.removeEventListener('scroll', conferir);
      };
      const observador = new IntersectionObserver(
        (entradas) =>
          entradas.forEach((e) => e.isIntersecting && liberar(e.target as HTMLElement)),
        { threshold: 0.2 },
      );
      // reserva: se o observador atrasar, a própria rolagem libera (o conteúdo nunca fica preso)
      const conferir = () =>
        esperando.forEach((el) => {
          if (el.getBoundingClientRect().top < window.innerHeight * 0.85) liberar(el);
        });

      hero.querySelectorAll<HTMLElement>('.hero__foto, .hero__dados').forEach((el) => {
        if (el.getBoundingClientRect().top < window.innerHeight * 0.85) return; // já visível
        el.dataset.espera = '';
        // recomeça do zero, caso a animação já tenha andado antes do script rodar
        el.getAnimations({ subtree: true }).forEach((animacao) => {
          if (animacao.timeline === document.timeline) animacao.currentTime = 0;
        });
        esperando.add(el);
        observador.observe(el);
      });
      if (esperando.size) window.addEventListener('scroll', conferir, { passive: true });
    }

    // ---------- Contagem dos números, no ritmo da entrada de cada placa ----------
    const saida = (t: number) => 1 - Math.pow(1 - t, 4);
    const duracao = 1100;
    hero.querySelectorAll<HTMLElement>('.hero__dado').forEach((placa) => {
      const el = placa.querySelector<HTMLElement>('.placa-dado__numero');
      const entrada = placa
        .getAnimations()
        .find((a) => a instanceof CSSAnimation && a.animationName === 'hero-placa-entra');
      const final = el?.textContent ?? '';
      const partes = final.match(/^(\D*)(\d+)(.*)$/);
      // sem animação de entrada (ou já terminada), o número fica como está
      if (!el || !entrada || entrada.playState === 'finished' || !partes) return;

      const [, antes, alvo, depois] = partes;
      const total = Number(alvo);
      let contando = false;

      const contar = (jaPassou: number) => {
        if (contando) return;
        contando = true;
        const inicio = performance.now() - jaPassou + 80;
        const passo = (agora: number) => {
          const t = Math.min(Math.max((agora - inicio) / duracao, 0), 1);
          el.textContent = t < 1 ? `${antes}${Math.round(total * saida(t))}${depois}` : final;
          if (t < 1) requestAnimationFrame(passo);
        };
        requestAnimationFrame(passo);
        // garantia: em aba de segundo plano (sem quadros), o número final aparece mesmo assim
        window.setTimeout(() => (el.textContent = final), duracao + 300);
      };

      el.textContent = `${antes}0${depois}`;
      const atraso = Number(entrada.effect?.getTiming().delay ?? 0);
      const andado = Number(entrada.currentTime ?? 0) - atraso;
      if (andado > 0) contar(andado); // a placa já começou a entrar antes do script
      placa.addEventListener('animationstart', (evento) => {
        if (evento.animationName === 'hero-placa-entra') contar(0);
      });
      placa.addEventListener('animationend', (evento) => {
        if (evento.animationName === 'hero-placa-entra') el.textContent = final;
      });
    });

    // ---------- Profundidade: a cena reage ao ponteiro (só mouse, telas largas) ----------
    if (window.matchMedia('(hover: hover) and (pointer: fine) and (min-width: 1024px)').matches) {
      let alvoX = 0;
      let alvoY = 0;
      let x = 0;
      let y = 0;
      let quadro = 0;

      const animar = () => {
        x += (alvoX - x) * 0.07;
        y += (alvoY - y) * 0.07;
        hero.style.setProperty('--px', x.toFixed(4));
        hero.style.setProperty('--py', y.toFixed(4));
        quadro =
          Math.abs(alvoX - x) > 0.0005 || Math.abs(alvoY - y) > 0.0005
            ? requestAnimationFrame(animar)
            : 0;
      };
      const pedir = () => {
        if (!quadro) quadro = requestAnimationFrame(animar);
      };

      hero.addEventListener('pointermove', (evento) => {
        const caixa = hero.getBoundingClientRect();
        alvoX = ((evento.clientX - caixa.left) / caixa.width) * 2 - 1;
        alvoY = ((evento.clientY - caixa.top) / caixa.height) * 2 - 1;
        hero.classList.add('hero--ponteiro');
        pedir();
      });
      hero.addEventListener('pointerleave', () => {
        alvoX = 0;
        alvoY = 0;
        hero.classList.remove('hero--ponteiro');
        pedir();
      });
    }
  }
</script>

<style>
  .hero {
    /* posição do ponteiro (-1 a 1), escrita pelo JS; 0 = cena parada */
    --px: 0;
    --py: 0;
    --saida: cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding: 104px 0 72px;
    background:
      radial-gradient(120% 70% at 50% 0%, var(--navy) 0%, transparent 70%),
      linear-gradient(180deg, var(--navy-profundo) 60%, var(--navy-noite) 100%);
  }

  /* ---------- Luz ---------- */
  .hero__luz {
    position: absolute;
    inset: 0;
    z-index: -1;
    /* a luz se apaga antes do fim da seção, sem corte seco na próxima */
    mask-image: linear-gradient(180deg, #000 70%, transparent 100%);
  }

  .hero__feixe,
  .hero__poeira {
    --feixe-largura: 300px;
    --feixe-x: 62%;
    --feixe-y: -20%;
    --feixe-altura: 150%;
  }

  /* o feixe acende de cima para baixo e acompanha o ponteiro de leve */
  .hero__feixe {
    translate: calc(-50% + var(--px) * 28px) 0;
    transform-origin: 50% 0;
    animation: hero-feixe-acende 1600ms var(--saida) backwards;
  }

  @keyframes hero-feixe-acende {
    from {
      opacity: 0;
      scale: 1 0.15;
    }
  }

  /* ---------- Poeira: partículas subindo devagar dentro do feixe ---------- */
  .hero__poeira {
    position: absolute;
    pointer-events: none;
    width: var(--feixe-largura);
    height: var(--feixe-altura);
    left: var(--feixe-x);
    top: var(--feixe-y);
    translate: calc(-50% + var(--px) * 40px) 0;
    rotate: var(--desvio-luz);
    mask-image: linear-gradient(180deg, transparent 12%, #000 34%, #000 62%, transparent 86%);
    animation: hero-aparece 2400ms ease 900ms backwards;
  }

  .hero__poeira i {
    position: absolute;
    left: var(--x);
    bottom: 12%;
    width: var(--tamanho);
    height: var(--tamanho);
    border-radius: 50%;
    background: var(--offwhite);
    box-shadow: 0 0 6px var(--azul-luz);
    opacity: 0;
    animation: hero-poeira var(--duracao) linear var(--atraso) infinite;
  }

  /* no celular, metade das partículas basta */
  .hero__poeira i:nth-child(n + 9) {
    display: none;
  }

  @keyframes hero-poeira {
    0% {
      opacity: 0;
      translate: 0 0;
    }
    15%,
    80% {
      opacity: var(--brilho);
    }
    100% {
      opacity: 0;
      translate: var(--deriva) -70vh;
    }
  }

  @keyframes hero-aparece {
    from {
      opacity: 0;
    }
  }

  .hero__brilho {
    position: absolute;
    left: 50%;
    top: 62%;
    width: 520px;
    height: 520px;
    translate: -50% -50%;
    background: radial-gradient(
      closest-side,
      color-mix(in oklab, var(--azul) 40%, transparent),
      transparent
    );
  }

  /* o brilho atrás da foto segue o ponteiro (mais que o feixe: dá profundidade) */
  .hero__brilho {
    translate: calc(-50% + var(--px) * 60px) calc(-50% + var(--py) * 40px);
    animation: hero-brilho 1800ms var(--saida) 200ms backwards;
  }

  @keyframes hero-brilho {
    from {
      opacity: 0;
      scale: 0.5;
    }
  }

  /* ---------- Texto ---------- */
  .hero__grade {
    display: grid;
    gap: 56px;
  }

  .hero__selo {
    position: relative;
    overflow: hidden;
    display: inline-block;
    padding: 7px 12px;
    margin-bottom: 20px;
    border: 1px solid color-mix(in oklab, var(--offwhite) 14%, transparent);
    border-radius: 999px;
    background: color-mix(in oklab, var(--navy) 60%, transparent);
    font-size: 0.75rem; /* mínimo de 12 px para rótulos */
    letter-spacing: 0.01em; /* cabe em uma linha a 390 px */
  }

  @media (min-width: 560px) {
    .hero__selo {
      letter-spacing: 0.1em;
    }
  }

  /* ---------- Entrada do texto ---------- */
  @keyframes hero-sobe {
    from {
      opacity: 0;
      translate: 0 18px;
      filter: blur(8px);
    }
  }

  .hero__selo {
    animation: hero-sobe 900ms var(--saida) 150ms backwards;
  }

  /* um reflexo atravessa o selo uma vez, a 67,5° */
  .hero__selo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      calc(var(--desvio-luz) + 90deg),
      transparent 35%,
      color-mix(in oklab, var(--azul-luz) 55%, transparent) 50%,
      transparent 65%
    );
    translate: -110% 0;
    animation: hero-reflexo 1400ms var(--saida) 900ms both;
    pointer-events: none;
  }

  @keyframes hero-reflexo {
    to {
      translate: 110% 0;
    }
  }

  /* título: palavra a palavra, cada uma sai do desfoque e assenta */
  .hero__palavra {
    display: inline-block;
    transform-origin: 0 100%;
    animation: hero-palavra 1000ms var(--saida) calc(260ms + var(--i) * 90ms) backwards;
  }

  @keyframes hero-palavra {
    from {
      opacity: 0;
      translate: 0 0.5em;
      rotate: 4deg;
      filter: blur(12px);
    }
  }

  /* a frase azul é revelada por uma varredura de luz inclinada a 67,5° */
  @keyframes hero-varredura {
    from {
      mask-image: linear-gradient(calc(var(--desvio-luz) + 90deg), #000 40%, transparent 56%);
      mask-size: 300% 100%;
      mask-repeat: no-repeat;
      mask-position: 100% 0;
      translate: 0 0.15em;
      filter: blur(6px);
    }
    to {
      mask-image: linear-gradient(calc(var(--desvio-luz) + 90deg), #000 40%, transparent 56%);
      mask-size: 300% 100%;
      mask-repeat: no-repeat;
      mask-position: 0 0;
    }
  }

  .hero__titulo-luz {
    animation: hero-varredura 1500ms var(--saida) 560ms backwards;
  }

  .hero__lead {
    animation: hero-sobe 1000ms var(--saida) 780ms backwards;
  }

  .hero__acao {
    animation: hero-sobe 1000ms var(--saida) 920ms backwards;
  }

  .hero__provas {
    animation: hero-linha 1200ms var(--saida) 1000ms backwards;
  }

  @keyframes hero-linha {
    from {
      border-top-color: transparent;
    }
  }

  .hero__provas li {
    animation: hero-sobe 800ms var(--saida) calc(1080ms + var(--i) * 110ms) backwards;
  }

  /* os losangos giram até os 45° da fita e acendem */
  .hero__provas li::before {
    animation: hero-losango 900ms cubic-bezier(0.3, 1.6, 0.5, 1) calc(1180ms + var(--i) * 110ms)
      backwards;
  }

  @keyframes hero-losango {
    from {
      scale: 0;
      rotate: calc(var(--ang-fita) + 180deg);
      box-shadow: 0 0 22px 6px var(--azul-luz);
    }
  }

  .hero__titulo {
    font-size: var(--fs-h1);
  }

  /* segunda frase com luz azulada, como o título da ref-01 */
  .hero__titulo-luz {
    display: block;
    background: linear-gradient(100deg, var(--offwhite) 10%, var(--azul-luz) 95%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__lead {
    margin-top: 20px;
    max-width: 34rem;
    font-size: var(--fs-lead);
    color: var(--texto-suave);
  }

  .hero__acao {
    margin-top: 32px;
  }

  .hero__acao :global(.botao) {
    width: 100%;
  }

  .hero__provas {
    display: grid;
    gap: 10px;
    margin-top: 32px;
    padding: 20px 0 0;
    list-style: none;
    border-top: 1px solid color-mix(in oklab, var(--offwhite) 10%, transparent);
    font-family: var(--fonte-mono);
    font-size: 0.8125rem;
    color: var(--texto-suave);
  }

  .hero__provas li {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* marcador: losango a 45° (a diagonal da fita) */
  .hero__provas li::before {
    content: '';
    flex: none;
    width: 7px;
    height: 7px;
    background: var(--azul);
    rotate: var(--ang-fita);
    box-shadow: 0 0 10px var(--azul);
  }

  /* ---------- Palco: foto + placas ---------- */
  .hero__palco {
    position: relative;
  }

  .hero__foto {
    width: 88%;
    margin-inline: auto;
    padding: 8px;
    border-radius: 28px;
    /* inclina com o ponteiro, como uma placa de vidro na mão */
    transform: perspective(1400px) rotateX(calc(var(--py) * -5deg)) rotateY(calc(var(--px) * 7deg));
    animation: hero-foto 1500ms var(--saida) 280ms backwards;
  }

  /* corte a 67,5° que sobe revelando a foto (e a borda acesa junto) */
  @keyframes hero-foto {
    from {
      opacity: 0.2;
      scale: 0.94;
      clip-path: polygon(-20% 133%, 120% 166%, 120% 200%, -20% 200%);
    }
    to {
      clip-path: polygon(-20% -50%, 120% -17%, 120% 200%, -20% 200%);
    }
  }

  .hero__foto :global(img) {
    translate: calc(var(--px) * -8px) calc(var(--py) * -6px);
    animation: hero-foto-assenta 2200ms var(--saida) 280ms backwards;
  }

  @keyframes hero-foto-assenta {
    from {
      scale: 1.18;
    }
  }

  /* reflexo do vidro que segue o ponteiro */
  .hero__foto::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      60% 45% at calc(50% + var(--px) * 45%) calc(35% + var(--py) * 35%),
      color-mix(in oklab, var(--offwhite) 16%, transparent),
      transparent 70%
    );
    mix-blend-mode: soft-light;
    opacity: 0;
    transition: opacity 600ms ease;
    pointer-events: none;
  }

  .hero--ponteiro .hero__foto::after {
    opacity: 1;
  }

  .hero__foto :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 21px;
    /* degradê navy sobre a foto (regra do brand book) */
    mask-image: linear-gradient(180deg, #000 60%, transparent 100%);
  }

  .hero__dados {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: -64px; /* a primeira fileira sobe sobre o pé desfocado da foto */
  }

  .hero__orbita {
    display: grid;
  }

  /* celular: segura a entrada até a foto e as placas aparecerem na tela (o JS liga e desliga) */
  .hero__foto[data-espera],
  .hero__foto[data-espera] :global(img),
  .hero__dados[data-espera] :global(.hero__dado) {
    animation-play-state: paused;
  }

  @media (max-width: 1023px) {
    .hero__foto,
    .hero__foto :global(img) {
      animation-delay: 0ms;
    }

    .hero__dados .hero__orbita :global(.hero__dado) {
      animation-delay: calc(var(--i) * 110ms);
    }
  }

  /* entrada: cada placa vem do seu lado, desfocada, e assenta em órbita */
  .hero__dados :global(.hero__dado) {
    --entra-x: 0px;
    --entra-y: 28px;
    overflow: hidden;
    animation: hero-placa-entra 1100ms var(--saida) calc(820ms + var(--i) * 120ms) backwards;
    transition:
      transform 700ms var(--saida),
      border-color 400ms ease,
      box-shadow 500ms ease;
  }

  @keyframes hero-placa-entra {
    from {
      opacity: 0;
      translate: var(--entra-x) var(--entra-y);
      scale: 0.86;
      filter: blur(10px);
    }
  }

  /* hover: a placa sobe, a borda acende e um reflexo a 67,5° atravessa o vidro */
  .hero__dados :global(.hero__dado)::after {
    content: '';
    position: absolute;
    inset: -10% -40%;
    background: linear-gradient(
      calc(var(--desvio-luz) + 90deg),
      transparent 38%,
      color-mix(in oklab, var(--offwhite) 16%, transparent) 50%,
      transparent 62%
    );
    translate: -100% 0;
    pointer-events: none;
  }

  .hero__dados :global(.placa-dado__numero) {
    transition:
      text-shadow 500ms ease,
      color 500ms ease;
  }

  @media (hover: hover) {
    .hero__dados :global(.hero__dado:hover) {
      transform: translateY(-6px) scale(1.04);
      border-color: color-mix(in oklab, var(--azul-fio) 80%, transparent);
      box-shadow:
        inset 0 0 32px color-mix(in oklab, var(--azul) 50%, transparent),
        inset 0 1px 0 color-mix(in oklab, var(--offwhite) 35%, transparent),
        0 24px 48px -16px color-mix(in oklab, var(--azul) 70%, transparent);
    }

    .hero__dados :global(.hero__dado.placa--acesa:hover) {
      box-shadow:
        var(--sombra-acesa),

---
// Seção 10 · Formatos: Online x Presencial. Sem preço. Luz alta.
// Minimalista: dois cartões de escolha (ref-05), uma linha com o que vale para os dois e um só
// botão laranja, que segue a escolha. Tudo com CSS (:has), funciona sem JavaScript.
// Movimento: os cartões sobem juntos; ao escolher, o cartão acende e o outro recua, sem pressa.
import { formatos, incluso, notaInvestimento, titulo } from '../../conteudo/formatos';
import BotaoWhatsApp from '../ui/BotaoWhatsApp.astro';

const palavras = titulo.split(' ');

// ícones dos formatos (traço de 1,75 em grade de 24)
const icones: Record<string, string> = {
  online:
    '<rect x="2.5" y="4" width="19" height="13" rx="2"/><path d="M8.5 21h7M12 17v4"/><path d="m10.5 8.2 4 2.3-4 2.3Z"/>',
  presencial:
    '<path d="M19.5 10c0 5-5.6 10.2-7 11.4a.8.8 0 0 1-1 0C10.1 20.2 4.5 15 4.5 10a7.5 7.5 0 0 1 15 0Z"/><circle cx="12" cy="10" r="2.6"/>',
};
---

<section class="formatos" aria-labelledby="formatos-titulo" id="formatos">
  <div class="formatos__luz" aria-hidden="true"></div>

  <div class="container">
    <header class="formatos__topo" data-revelar>
      <p class="rotulo rotulo-digita" style="--letras: 8">Formatos</p>
      <h2 id="formatos-titulo" class="formatos__titulo">
        {
          palavras.map((palavra, i) => (
            <>
              <span class="formatos__palavra" style={`--i:${i}`}>
                {palavra}
              </span>{' '}
            </>
          ))
        }
      </h2>
    </header>

    <!-- Escolha do formato -->
    <fieldset class="formatos__escolha">
      <legend class="visualmente-oculto">Escolha o formato da mentoria</legend>
      <div class="formatos__placas" data-revelar-grupo="(min-width: 768px)">
        {
          formatos.map((formato, i) => (
            <div class="placa holofote formato" style={`--i:${i}`} data-revelar>
              <input
                class="visualmente-oculto"
                type="radio"
                name="formato"
                id={`formato-${formato.id}`}
                value={formato.id}
                checked={formato.id === 'online'}
              />
              <div class="formato__topo">
                <span class="formato__icone" aria-hidden="true">
                  <svg viewBox="0 0 24 24" set:html={icones[formato.id]} />
                </span>
                <span class="formato__marca" aria-hidden="true" />
              </div>
              <label class="formato__nome" for={`formato-${formato.id}`}>
                {formato.nome}
              </label>
              <p class="formato__resumo">{formato.resumo}</p>
              <p class:list={['formato__alcance', { 'formato__alcance--restrito': formato.restrito }]}>
                <span class="formato__ponto" aria-hidden="true" />
                {formato.alcance}
              </p>
            </div>
          ))
        }
      </div>
    </fieldset>

    <!-- O que vale para os dois, numa linha -->
    <div class="formatos__incluso" data-revelar>
      <p class="rotulo formatos__incluso-rotulo">Nos dois formatos</p>
      <ul class="formatos__itens" role="list">
        {incluso.map((item, i) => <li style={`--i:${i}`}>{item}</li>)}
      </ul>
    </div>

    <div class="formatos__acao" data-revelar>
      <div class="formatos__botoes">
        {
          formatos.map((formato) => (
            <BotaoWhatsApp
              origem={formato.cta}
              class={`formatos__botao formatos__botao--${formato.id}`}
            >
              {formato.textoBotao}
            </BotaoWhatsApp>
          ))
        }
      </div>
      <p class="formatos__nota">{notaInvestimento}</p>
    </div>
  </div>
</section>

<style>
  .formatos {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding: 96px 0 104px;
    background: var(--navy-profundo);
  }

  .formatos__luz {
    position: absolute;
    inset: 0;
    z-index: -1;
    /* uma luz só, atrás dos cartões; some no topo para não marcar a emenda */
    background: radial-gradient(
      70% 45% at 50% 55%,
      color-mix(in oklab, var(--azul) 30%, transparent),
      transparent 70%
    );
    mask-image: linear-gradient(180deg, transparent, #000 18%, #000 85%, transparent);
  }

  /* ---------- Topo ---------- */
  .formatos__topo {
    text-align: center;
  }

  .formatos__titulo {
    margin: 12px auto 0;
    max-width: 18ch;
    font-size: var(--fs-h2);
  }

  .formatos__palavra {
    display: inline-block;
    animation: mov-sobe 900ms var(--saida) calc(300ms + var(--i) * 60ms) backwards;
  }

  /* ---------- Cartões ---------- */
  .formatos__escolha {
    margin: 48px 0 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .formatos__placas {
    display: grid;
    gap: 12px;
  }

  .formato {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: 24px 22px 24px;
    cursor: pointer;
    transition:
      background 500ms ease,
      border-color 500ms ease,
      box-shadow 500ms ease,
      opacity 500ms ease,
      scale 600ms var(--saida),
      translate 600ms var(--saida);
    /* entrada: os dois sobem juntos, um logo depois do outro */
    animation: formatos-sobe 1000ms var(--saida) calc(var(--lote, 0ms) + var(--i) * 120ms) backwards;
  }

  @keyframes formatos-sobe {
    from {
      opacity: 0;
      translate: 0 28px;
      filter: blur(6px);
    }
  }

  /* com overflow escondido, o anel do holofote fica por dentro da borda */
  .formato.holofote::before {
    inset: 0;
  }

  /* o que não foi escolhido recua um pouco: a escolha fica óbvia sem precisar de mais texto */
  .formato:not(:has(input:checked)) {
    opacity: 0.62;
    scale: 0.985;
  }

  @media (hover: hover) {
    .formato:hover {
      opacity: 1;
      translate: 0 -3px;
    }
  }

  .formato:has(input:focus-visible) {
    outline: 2px solid var(--azul-fio);
    outline-offset: 3px;
  }

  .formato__topo {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .formato__icone {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    border: 1px solid color-mix(in oklab, var(--offwhite) 12%, transparent);
    background: color-mix(in oklab, var(--offwhite) 5%, transparent);
    color: var(--texto-suave);
    transition:
      background-color 500ms ease,
      color 500ms ease,
      border-color 500ms ease,
      box-shadow 500ms ease;
  }

  .formato__icone svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .formato:has(input:checked) .formato__icone {
    color: var(--offwhite);
    border-color: color-mix(in oklab, var(--azul-fio) 70%, transparent);
    background: color-mix(in oklab, var(--azul) 60%, transparent);
    box-shadow: 0 0 18px color-mix(in oklab, var(--azul) 60%, transparent);
  }

  /* marcador de escolha: losango que se preenche */
  .formato__marca {
    width: 16px;
    height: 16px;
    margin-right: 3px;
    rotate: var(--ang-fita);
    border: 1.5px solid color-mix(in oklab, var(--offwhite) 40%, transparent);
    border-radius: 2px;
    transition:
      background-color 400ms ease,
      border-color 400ms ease,
      box-shadow 400ms ease,
      scale 500ms var(--mola);
  }

  .formato:has(input:checked) .formato__marca {
    background: var(--offwhite);
    border-color: var(--offwhite);
    box-shadow: 0 0 12px var(--azul-luz);
    scale: 1.1;
  }

  /* o rótulo do nome cobre o cartão inteiro: clicar em qualquer ponto escolhe o formato */
  .formato__nome {
    margin-top: 22px;
    font-size: clamp(2rem, 1.6rem + 2vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1;
    cursor: pointer;
  }

  .formato__nome::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .formato__resumo {
    margin-top: 10px;
    max-width: 22rem;
    color: var(--texto-suave);
    transition: color 500ms ease;
  }

  .formato:has(input:checked) .formato__resumo {
    color: color-mix(in oklab, var(--offwhite) 88%, var(--azul));
  }

  .formato__alcance {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    margin-top: 22px;
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid color-mix(in oklab, var(--offwhite) 16%, transparent);
    font-family: var(--fonte-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--texto-suave);
  }

  .formato__ponto {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--azul-luz);
  }

  /* presencial: a restrição de região fica sempre visível e o ponto pulsa */
  .formato__alcance--restrito {
    border-color: color-mix(in oklab, var(--azul-luz) 55%, transparent);
    background: color-mix(in oklab, var(--azul) 20%, transparent);
    color: var(--offwhite);
  }

  .formato__alcance--restrito .formato__ponto {
    animation: formatos-local 2.4s ease-out 1s infinite;
  }

  @keyframes formatos-local {
    0% {
      box-shadow: 0 0 0 0 color-mix(in oklab, var(--azul-luz) 70%, transparent);
    }
    70%,
    100% {
      box-shadow: 0 0 0 7px transparent;
    }
  }

  /* ---------- Incluso nos dois ---------- */
  .formatos__incluso {
    display: grid;
    justify-items: center;
    gap: 12px;
    margin-top: 32px;
    text-align: center;
  }

  .formatos__incluso-rotulo {
    font-size: 0.75rem;
    animation: mov-aparece 700ms ease backwards;
  }

  .formatos__itens {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    padding: 0;
    list-style: none;
  }

  .formatos__itens li {
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid color-mix(in oklab, var(--offwhite) 12%, transparent);
    background: color-mix(in oklab, var(--offwhite) 4%, transparent);
    font-size: var(--fs-pequeno);
    color: var(--texto-suave);
    animation: mov-sobe 700ms var(--saida) calc(150ms + var(--i) * 70ms) backwards;
  }

  /* ---------- Ação: um só botão laranja, conforme a escolha ---------- */
  .formatos__acao {
    display: grid;
    justify-items: center;
    gap: 14px;
    margin-top: 36px;
    text-align: center;
    animation: mov-sobe 900ms var(--saida) 200ms backwards;
  }

  .formatos__botoes {
    width: 100%;
  }

  .formatos__acao :global(.botao) {
    width: 100%;
  }

  .formatos__acao :global(.formatos__botao--presencial) {
    display: none;
  }

  .formatos:has(input[value='presencial']:checked) .formatos__acao :global(.formatos__botao--online) {
    display: none;
  }

  .formatos:has(input[value='presencial']:checked) .formatos__acao :global(.formatos__botao--presencial) {
    display: inline-flex;
  }

  /* troca de botão: um nome de animação por escolha, para repetir a cada troca */
  .formatos:has(input[value='online']:checked) [data-revelado] .formatos__botoes {
    animation: formatos-troca-a 450ms var(--saida);
  }

  .formatos:has(input[value='presencial']:checked) [data-revelado] .formatos__botoes {
    animation: formatos-troca-b 450ms var(--saida);
  }

  @keyframes formatos-troca-a {
    from {
      opacity: 0.3;
      translate: 0 6px;
    }
  }

  @keyframes formatos-troca-b {
    from {
      opacity: 0.3;
      translate: 0 6px;
    }
  }

  .formatos__nota {
    max-width: 34rem;
    font-size: 0.8125rem;
    color: var(--texto-apagado);
  }

  @media (min-width: 560px) {
    .formatos__botoes {
      width: auto;
    }

    .formatos__acao :global(.botao) {
      width: auto;
    }
  }

  @media (min-width: 768px) {
    .formatos__placas {
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .formato {
      min-height: 300px;
      padding: 30px 30px 30px;
    }

    .formato__alcance {
      margin-top: auto;
    }

    .formato__resumo {
      margin-bottom: 24px;
    }
  }

  @media (min-width: 1024px) {
    .formatos {
      padding: 128px 0;
    }

    .formatos__escolha {
      max-width: 880px;
      margin: 64px auto 0;
    }

    .formato {
      min-height: 320px;
      padding: 36px;
    }

    .formatos__incluso {
      margin-top: 40px;
    }

    .formatos__acao {
      margin-top: 40px;
    }
  }
</style>

---
// Seção 3 · "Você se reconhece?" (ref-05): placas apagadas que acendem quando marcadas.
// Luz baixa: a única luz da seção vem do que a pessoa marca.
// Sem JavaScript: as placas continuam marcáveis (CSS) e o botão usa a mensagem padrão.
// Movimento: o rótulo é "digitado" como num painel, o título sobe e a frase azul é varrida pela
// luz; as placas entram em onda diagonal (45°) com uma linha de varredura de diagnóstico.
// Marcar uma placa solta uma onda de luz do ponto do toque, o losango estoura e o medidor sobe.
import { situacoes } from '../../conteudo/identificacao';
import BotaoWhatsApp from '../ui/BotaoWhatsApp.astro';
---

<section class="identificacao" aria-labelledby="identificacao-titulo" data-identificacao>
  <div class="identificacao__brilho" aria-hidden="true"></div>

  <div class="container identificacao__grade">
    <div class="identificacao__topo" data-revelar>
      <p class="rotulo rotulo-digita" style="--letras: 18">Diagnóstico rápido</p>
      <h2 id="identificacao-titulo" class="identificacao__titulo">
        <span class="identificacao__titulo-base">6 travas comuns em marketplace.</span>
        <span class="identificacao__titulo-luz">Quais estão na sua operação?</span>
      </h2>
      <p class="identificacao__sub">Marque o que acontece hoje na sua empresa.</p>
    </div>

    <fieldset class="identificacao__placas">
      <legend class="visualmente-oculto">Situações que acontecem hoje na sua empresa</legend>
      {
        situacoes.map((situacao, i) => (
          <label
            class="placa holofote dor"
            style={`--linha:${Math.floor(i / 2)};--coluna:${i % 2}`}
            data-revelar
          >
            <input
              class="visualmente-oculto"
              type="checkbox"
              name="situacao"
              value={situacao.id}
              data-resumo={situacao.resumo}
            />
            <span class="dor__varredura" aria-hidden="true" />
            <span class="dor__topo" aria-hidden="true">
              <span class="numero dor__numero">{String(i + 1).padStart(2, '0')}</span>
              <span class="dor__marca" />
            </span>
            <span class="dor__corpo">
              <span class="dor__titulo">{situacao.titulo}</span>
              <span class="dor__texto">{situacao.texto}</span>
            </span>
          </label>
        ))
      }
    </fieldset>

    <div class="identificacao__acao" data-revelar>
      <div class="identificacao__painel" data-painel hidden>
        <div class="identificacao__medidor" aria-hidden="true">
          {situacoes.map(() => <span class="identificacao__segmento" />)}
        </div>
        <p class="identificacao__contagem numero" aria-live="polite" data-contagem></p>
      </div>
      <p class="identificacao__fecho">
        Se você se viu em pelo menos uma dessas situações, vale uma conversa.
      </p>
      <div class="identificacao__botao">
        <BotaoWhatsApp origem="identificacao">Conversar com o Marcelo</BotaoWhatsApp>
      </div>
      <p class="identificacao__nota" data-nota hidden>O que você marcou já vai na mensagem.</p>
    </div>
  </div>
</section>

<script>
  import { linkWhatsApp, MENSAGENS_WHATSAPP } from '../../config/site';

  const secao = document.querySelector<HTMLElement>('[data-identificacao]');

  if (secao) {
    const caixas = [...secao.querySelectorAll<HTMLInputElement>('input[name="situacao"]')];
    const botao = secao.querySelector<HTMLAnchorElement>('a[data-cta="identificacao"]');
    const contagem = secao.querySelector<HTMLElement>('[data-contagem]');
    const nota = secao.querySelector<HTMLElement>('[data-nota]');
    const painel = secao.querySelector<HTMLElement>('[data-painel]');
    const segmentos = [...secao.querySelectorAll<HTMLElement>('.identificacao__segmento')];
    let anterior = -1;

    if (painel) painel.hidden = false;

    // a onda de luz nasce do ponto do toque (no teclado, do centro da placa)
    secao.addEventListener('pointerdown', (evento) => {
      const placa = (evento.target as Element).closest<HTMLElement>('.dor');
      if (!placa) return;
      const caixa = placa.getBoundingClientRect();
      placa.style.setProperty('--onda-x', `${evento.clientX - caixa.left}px`);
      placa.style.setProperty('--onda-y', `${evento.clientY - caixa.top}px`);
    });

    const atualizar = () => {
      const marcadas = caixas.filter((caixa) => caixa.checked);
      const total = marcadas.length;

      // a luz da seção cresce com o que foi marcado
      secao.style.setProperty('--intensidade', String(total / caixas.length));

      if (contagem) {
        contagem.textContent = `${total} de ${caixas.length} marcadas`;
        // o número "vira" a cada mudança (reinicia a animação)
        if (anterior !== -1 && anterior !== total) {
          contagem.classList.remove('identificacao__contagem--vira');
          void contagem.offsetWidth;
          contagem.classList.add('identificacao__contagem--vira');
        }
      }
      segmentos.forEach((segmento, i) =>
        segmento.classList.toggle('identificacao__segmento--aceso', i < total),
      );
      if (nota) nota.hidden = total === 0;
      anterior = total;

      if (botao) {
        const mensagem =
          total === 0
            ? MENSAGENS_WHATSAPP.identificacao
            : [
                'Olá, Marcelo! Vim pela sua página e me reconheci nestas situações:',
                ...marcadas.map((caixa) => `• ${caixa.dataset.resumo}`),
                'Quero conversar sobre a mentoria.',
              ].join('\n');
        botao.href = linkWhatsApp(mensagem);
      }
    };

    caixas.forEach((caixa) => caixa.addEventListener('change', atualizar));
    atualizar(); // o navegador pode restaurar marcações ao voltar para a página
  }
</script>

<style>
  .identificacao {
    --intensidade: 0;
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding: 88px 0 96px;
    background: var(--navy-noite);
  }

  /* brilho lateral que acende conforme as marcações */
  .identificacao__brilho {
    position: absolute;
    z-index: -1;
    right: -20%;
    top: 10%;
    width: 80%;
    height: 80%;
    background: radial-gradient(
      closest-side,
      color-mix(in oklab, var(--azul) 45%, transparent),
      transparent
    );
    opacity: calc(0.12 + var(--intensidade) * 0.6);
    transition: opacity 600ms ease;
  }

  .identificacao__grade {
    display: grid;
    gap: 40px;
  }

  .identificacao__titulo {
    margin-top: 12px;
    font-size: var(--fs-h2);
  }

  .identificacao__titulo-base,
  .identificacao__titulo-luz {
    display: block;
  }

  .identificacao__titulo-luz {
    color: var(--azul-luz);
  }

  /* ---------- Entrada do topo ---------- */
  .identificacao__titulo-base {
    animation: mov-sobe 1000ms var(--saida) 380ms backwards;
  }

  .identificacao__titulo-luz {
    animation: mov-varredura 1400ms var(--saida) 620ms backwards;
  }

  .identificacao__sub {
    animation: mov-sobe 900ms var(--saida) 820ms backwards;
  }

  .identificacao__sub {
    margin-top: 12px;
    color: var(--texto-suave);
    font-size: var(--fs-lead);
  }

  /* ---------- Placas ---------- */
  .identificacao__placas {
    display: grid;
    gap: 12px;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .dor {
    /* celular: cascata entre as placas que aparecem juntas */
    --atraso: var(--lote, 0ms);
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 18px 18px 20px;
    cursor: pointer;
    transition:
      background-color var(--transicao),
      border-color var(--transicao),
      box-shadow var(--transicao),
      transform 500ms var(--saida);
    -webkit-tap-highlight-color: transparent;
    /* entrada: a placa sai do escuro enquanto a linha de diagnóstico passa por ela */
    animation: identificacao-placa 1000ms var(--saida) var(--atraso) backwards;
  }

  @keyframes identificacao-placa {
    from {
      opacity: 0;
      translate: 0 28px;
      scale: 0.96;
      filter: blur(8px);
    }
  }

  @media (hover: hover) {
    .dor:hover {
      transform: translateY(-3px);
    }

    .dor:hover .dor__marca {
      border-color: var(--azul-fio);
      rotate: calc(var(--ang-fita) + 90deg);
    }
  }

  .dor:active {
    transform: scale(0.985);
  }

  /* linha de varredura (diagnóstico) e onda do clique, numa camada no formato da placa */
  .dor__varredura {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    border-radius: inherit;
    pointer-events: none;
  }

  .dor__varredura::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 46%;
    background: linear-gradient(
      180deg,
      transparent,
      color-mix(in oklab, var(--azul) 22%, transparent) 80%,
      color-mix(in oklab, var(--azul-luz) 70%, transparent) 99%,
      transparent
    );
    translate: 0 -100%;
    animation: identificacao-varre 1300ms cubic-bezier(0.45, 0, 0.2, 1) calc(var(--atraso) + 150ms)
      both;
  }

  @keyframes identificacao-varre {
    to {
      translate: 0 230%;
    }
  }

  /* onda de luz que nasce do toque quando a placa é marcada */
  .dor__varredura::after {
    content: '';
    position: absolute;
    left: var(--onda-x, 50%);
    top: var(--onda-y, 50%);
    width: 24px;
    height: 24px;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      color-mix(in oklab, var(--azul-luz) 70%, transparent),
      color-mix(in oklab, var(--azul) 30%, transparent) 60%,
      transparent
    );
    opacity: 0;
  }

  .dor:has(input:checked) .dor__varredura::after {
    animation: identificacao-onda 900ms var(--saida);
  }

  @keyframes identificacao-onda {
    from {
      opacity: 1;
      scale: 0;
    }
    to {
      opacity: 0;
      scale: 32;
    }
  }

  .dor:has(input:focus-visible) {
    outline: 2px solid var(--azul-fio);
    outline-offset: 3px;
  }

  .dor__topo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .dor__numero {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--texto-apagado);
    transition: color var(--transicao);
  }

  .dor__corpo {
    display: grid;
    gap: 4px;
  }

  /* o título é o que a pessoa lê primeiro: grande, claro e em caixa normal */
  .dor__titulo {
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--texto);
  }

  /* marcador em losango (45°, a diagonal da fita) */
  .dor__marca {
    position: relative;
    flex: none;
    width: 14px;
    height: 14px;
    margin-right: 3px;
    rotate: var(--ang-fita);
    border: 1.5px solid color-mix(in oklab, var(--offwhite) 40%, transparent);
    border-radius: 2px;
    transition:
      background-color var(--transicao),
      border-color var(--transicao),
      box-shadow var(--transicao),
      rotate 600ms var(--saida);
  }

  /* anel que estoura quando a placa é marcada */
  .dor__marca::after {
    content: '';
    position: absolute;
    inset: -3px;
    border: 1.5px solid var(--azul-luz);
    border-radius: 3px;
    opacity: 0;
  }

  .dor:has(input:checked) .dor__marca {
    animation: identificacao-marca 600ms var(--mola);
  }

  .dor:has(input:checked) .dor__marca::after {
    animation: identificacao-anel 700ms var(--saida);
  }

  @keyframes identificacao-marca {
    from {
      scale: 0.3;
    }
  }

  @keyframes identificacao-anel {
    from {
      opacity: 1;
      scale: 1;
    }
    to {
      opacity: 0;
      scale: 2.6;
    }
  }

  .dor__texto {
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--texto-suave);
    transition: color var(--transicao);
  }

  .dor:has(input:checked) .dor__marca {
    background: var(--offwhite);
    border-color: var(--offwhite);
    box-shadow: 0 0 12px var(--azul-luz);
  }

  .dor:has(input:checked) .dor__numero {
    color: var(--azul-luz);
  }

  .dor:has(input:checked) .dor__titulo {
    color: var(--offwhite);
  }

  .dor:has(input:checked) .dor__texto {
    color: color-mix(in oklab, var(--offwhite) 85%, var(--azul));
  }

  /* ---------- Ação ---------- */
  /* o botão vai num invólucro: a animação de entrada não substitui o pulso dele */
  .identificacao__painel,
  .identificacao__fecho,
  .identificacao__botao {
    animation: mov-sobe 900ms var(--saida) backwards;
  }

  .identificacao__fecho {
    animation-delay: 100ms;
  }

  .identificacao__botao {
    animation-delay: 200ms;
  }

  /* medidor: 6 segmentos cortados a 67,5° que acendem conforme as marcações */
  .identificacao__painel {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 14px;
  }

  .identificacao__painel[hidden] {
    display: none;
  }

  .identificacao__medidor {
    display: flex;
    gap: 4px;
  }

  .identificacao__segmento {
    width: 14px;
    height: 16px;
    transform: skewX(calc(var(--desvio-luz) * -1));
    border-radius: 2px;
    background: color-mix(in oklab, var(--offwhite) 12%, transparent);
    transition:
      background-color 400ms ease,
      box-shadow 400ms ease,
      scale 400ms var(--mola);
  }

  .identificacao__segmento--aceso {
    background: var(--azul-luz);
    box-shadow: 0 0 12px color-mix(in oklab, var(--azul-luz) 80%, transparent);
    scale: 1 1.15;
  }

  .identificacao__contagem {
    font-size: var(--fs-pequeno);
    color: var(--azul-luz);
    letter-spacing: 0.02em;
  }

  /* o número vira como um contador mecânico */
  .identificacao__contagem--vira {
    animation: identificacao-vira 420ms var(--saida);
  }

  @keyframes identificacao-vira {
    from {
      opacity: 0;
      translate: 0 -0.6em;
      filter: blur(3px);
    }
  }

  .identificacao__fecho {
    max-width: 30rem;
    margin-bottom: 20px;
    font-size: var(--fs-lead);
    font-weight: 600;
  }

  .identificacao__acao :global(.botao) {
    width: 100%;
  }

  .identificacao__nota {
    margin-top: 12px;
    font-size: var(--fs-pequeno);
    color: var(--texto-suave);
  }

  /* aparece deslizando quando a primeira placa é marcada */
  .identificacao__nota:not([hidden]) {
    animation: mov-sobe 600ms var(--saida);
  }

  @media (min-width: 560px) {
    .identificacao__acao :global(.botao) {
      width: auto;
    }
  }

  @media (min-width: 768px) {
    .identificacao__placas {
      grid-template-columns: 1fr 1fr;
    }

    .dor {
      /* onda diagonal (45°): cada passo para a direita ou para baixo atrasa um pouco */
      --atraso: calc((var(--linha) + var(--coluna)) * 110ms);
      min-height: 168px;
      padding: 22px 22px 24px;
      justify-content: space-between;
    }
  }

  /* telas largas: título e ação fixos à esquerda, placas à direita */
  @media (min-width: 1024px) {
    .identificacao {
      padding: 128px 0;
    }

    .identificacao__grade {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      grid-template-areas:
        'topo placas'
        'acao placas';
      grid-template-rows: auto 1fr;
      column-gap: 64px;
      row-gap: 40px;
    }

    .identificacao__topo {
      grid-area: topo;
    }

    .identificacao__placas {
      grid-area: placas;
    }

    /* lado a lado com o título: a ação só entra depois que o título assentou */
    .identificacao__painel {
      animation-delay: 700ms;
    }

    .identificacao__fecho {
      animation-delay: 800ms;
    }

    .identificacao__botao {
      animation-delay: 900ms;
    }

    .identificacao__acao {
      grid-area: acao;
      align-self: start;
      position: sticky;
      top: 32px;
    }
  }
</style>

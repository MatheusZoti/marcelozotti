---
// Bento da seção 5 (referência: bento escuro com luz azul e mini-widgets).
// Cada bloco mostra um dado real dos pitches/brand book desenhado como um pequeno gráfico.
// Uma placa acesa (a experiência), o resto apagado; as fotos são reais (estoque e rosto do Marcelo).
// Movimento: no desktop o bento entra inteiro, montando em cascata pela ordem de importância;
// no celular cada bloco entra quando aparece. Depois, cada mini-gráfico ganha vida: a trajetória
// sobe ano a ano até "hoje", você e o Marcelo se conectam, as semanas enchem e são percorridas,
// as frentes correm em trilhos, os marketplaces giram para a frente. Hover: luz que segue o mouse
// e o gráfico de cada bloco reage.
import { Image } from 'astro:assets';
import { siShopee } from 'simple-icons';
import fotoEstoque from '../assets/fotos/estoque-brazotti.jpg';
import fotoRosto from '../assets/fotos/marcelo-rosto.jpg';
import { bento, faturamento } from '../conteudo/marcelo';
import { frentes } from '../conteudo/frentes';
import MarcaMercadoLivre from './ui/MarcaMercadoLivre.astro';

const { experiencia, operacao, atuacao, individual, aoVivo, frentes: blocoFrentes, foco } = bento;

// trajetória: 6 marcos (um por ano) subindo em degraus de 45°, a diagonal da fita
const marcos = [20, 92, 164, 236, 308, 380].map((x, i) => ({ x, y: 150 - i * 26 }));
const trajeto = marcos
  .map((m, i) => (i === 0 ? `M${m.x},${m.y}` : `H${m.x - 26} L${m.x},${m.y}`))
  .join(' ');
const ultimo = marcos[marcos.length - 1];

// ícones da atuação (traço de 1,75 em grade de 24)
const iconesAtuacao = [
  '<path d="M3 9.5 4.6 4h14.8L21 9.5"/><path d="M3 9.5h18v.5a3 3 0 0 1-6 0 3 3 0 0 1-6 0 3 3 0 0 1-6 0Z"/><path d="M4.5 13v7h15v-7"/><path d="M10 20v-4.5h4V20"/>',
  '<circle cx="9" cy="8" r="3.2"/><path d="M3.5 19.5a5.5 5.5 0 0 1 11 0"/><path d="M16 4.8a3.2 3.2 0 0 1 0 6.2"/><path d="M17.6 14a5.5 5.5 0 0 1 2.9 5.5"/>',
  '<rect x="3" y="4" width="18" height="12" rx="1.5"/><path d="M12 16v4M8.5 20h7"/><path d="m7 12.5 3-3 2.5 2.5L17 7.5"/>',
];

// frentes em dois trilhos que correm em sentidos opostos (cada um repetido para o laço)
const trilhos = [frentes.slice(0, 4), frentes.slice(4)];
---

<ul class="bento" role="list" data-revelar-grupo="(min-width: 1024px)">
  <!-- A · experiência: trajetória de 6 anos até hoje, a única placa acesa -->
  <li class="placa placa--acesa holofote bloco bloco--experiencia" data-revelar>
    <span class="bloco__feixe" aria-hidden="true"></span>
    <span class="rotulo bloco__rotulo">{experiencia.rotulo}</span>

    <svg class="trajetoria" viewBox="0 0 400 172" aria-hidden="true">
      <defs>
        <linearGradient id="trajetoria-area" x1="0" y1="0" x2="0" y2="1">
          <stop class="trajetoria__stop-forte" offset="0"></stop>
          <stop class="trajetoria__stop-fraco" offset="1"></stop>
        </linearGradient>
        <linearGradient id="trajetoria-linha" x1="0" y1="0" x2="1" y2="0">
          <stop class="trajetoria__stop-inicio" offset="0"></stop>
          <stop class="trajetoria__stop-fim" offset="1"></stop>
        </linearGradient>
      </defs>
      {[20, 59, 98, 137].map((y) => <line class="trajetoria__grade" x1="0" x2="400" y1={y} y2={y} />)}
      <path class="trajetoria__area" d={`${trajeto} V160 H20 Z`}></path>
      <path class="trajetoria__linha" d={trajeto} pathLength="1"></path>
      {
        marcos.map((m, i) => (
          <circle
            class={`trajetoria__marco${i === marcos.length - 1 ? ' trajetoria__marco--hoje' : ''}`}
            cx={m.x}
            cy={m.y}
            r={i === marcos.length - 1 ? 6 : 4}
            style={`--i:${i}`}
          />
        ))
      }
      <circle class="trajetoria__halo" cx={ultimo.x} cy={ultimo.y} r="6"></circle>
      <text class="trajetoria__legenda" x="20" y="171">ANO 1</text>
      <text class="trajetoria__legenda trajetoria__legenda--hoje" x="380" y="171" text-anchor="end">
        HOJE
      </text>
    </svg>

    <div class="bloco__base">
      <span class="numero bloco__gigante" data-contar data-contar-atraso="380">
        {experiencia.numero}
      </span>
      <p class="bloco__texto">{experiencia.texto}</p>
      {
        faturamento.exibir && (
          <p class="bloco__faturamento">
            <strong class="numero">{faturamento.numero}</strong> {faturamento.rotulo}
            <span>{faturamento.nota}</span>
          </p>
        )
      }
    </div>
  </li>

  <!-- B · operação própria: foto real do estoque com degradê navy (regra do brand book) -->
  <li class="placa bloco bloco--operacao" data-revelar>
    <Image
      class="bloco__foto"
      src={fotoEstoque}
      alt="Estoque da Brazotti Distribuidora, com paletes de caixas e prateleiras de produtos"
      widths={[480, 720, 1000]}
      sizes="(min-width: 1024px) 590px, 92vw"
      loading="lazy"
    />
    <div class="bloco__topo">
      <span class="rotulo bloco__rotulo">{operacao.rotulo}</span>
      <span class="ao-vivo"><i aria-hidden="true"></i>{operacao.selo}</span>
    </div>
    <div class="bloco__base">
      <h3 class="bloco__titulo">{operacao.titulo}</h3>
      <p class="bloco__texto">{operacao.texto}</p>
    </div>
  </li>

  <!-- C · atuação: lista com ícones, no estilo de tabela -->
  <li class="placa holofote bloco bloco--atuacao" data-revelar>
    <span class="rotulo bloco__rotulo">{atuacao.rotulo}</span>
    <ul class="atuacao" role="list">
      {
        atuacao.itens.map((item, i) => (
          <li style={`--i:${i}`}>
            <span class="atuacao__icone" aria-hidden="true">
              <svg viewBox="0 0 24 24" set:html={iconesAtuacao[i]} />
            </span>
            {item}
          </li>
        ))
      }
    </ul>
    <h3 class="bloco__titulo bloco__titulo--menor">{atuacao.titulo}</h3>
  </li>

  <!-- D · 1:1: você e o Marcelo, ligados direto -->
  <li class="placa holofote bloco bloco--individual" data-revelar>
    <span class="rotulo bloco__rotulo">{individual.rotulo}</span>
    <div class="dupla" aria-hidden="true">
      <span class="dupla__avatar dupla__avatar--voce">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="8.5" r="3.6"></circle><path d="M5 20a7 7 0 0 1 14 0"></path></svg>
      </span>
      <span class="dupla__elo"><i></i></span>
      <span class="dupla__avatar dupla__avatar--ele">
        <Image src={fotoRosto} alt="" widths={[96, 144]} sizes="48px" loading="lazy" />
      </span>
    </div>
    <div class="bloco__base">
      <span class="numero bloco__numero">{individual.numero}</span>
      <p class="bloco__texto">{individual.texto}</p>
    </div>
  </li>

  <!-- E · 8h: as 4 semanas de 2h, percorridas por uma luz -->
  <li class="placa holofote bloco bloco--aovivo" data-revelar>
    <span class="rotulo bloco__rotulo bloco__rotulo--vivo">{aoVivo.rotulo}</span>
    <div class="aovivo">
      <div class="bloco__base">
        <span class="numero bloco__numero" data-contar data-contar-atraso="380">
          {aoVivo.numero}
        </span>
        <p class="bloco__texto">{aoVivo.texto}</p>
      </div>
      <ol class="encontros" aria-label="4 encontros de 2 horas, um por semana">
        {
          Array.from({ length: aoVivo.encontros }, (_, i) => (
            <li class="encontro" style={`--i:${i}`}>
              <span class="encontro__barra" />
              <span class="encontro__legenda">
                <span>
                  S<span class="encontro__extenso">em. </span>{i + 1}
                </span>
                <span>2h</span>
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </li>

  <!-- F · 7 frentes: dois trilhos de etiquetas correndo em sentidos opostos -->
  <li class="placa holofote bloco bloco--frentes" data-revelar>
    <span class="rotulo bloco__rotulo">{blocoFrentes.rotulo}</span>
    <ul class="visualmente-oculto">
      {frentes.map((frente) => <li>{frente.titulo}</li>)}
    </ul>
    <div class="trilhos" aria-hidden="true">
      {
        trilhos.map((trilho, t) => (
          <div class={`trilho${t === 1 ? ' trilho--volta' : ''}`}>
            <div class="trilho__faixa">
              {[...trilho, ...trilho].map((frente, i) => (
                <span class={`etiqueta${i % trilho.length === 0 ? ' etiqueta--acesa' : ''}`}>
                  {frente.titulo}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
    <div class="bloco__base">
      <span class="numero bloco__numero" data-contar data-contar-atraso="380">
        {blocoFrentes.numero}
      </span>
      <p class="bloco__texto">{blocoFrentes.texto}</p>
    </div>
  </li>

  <!-- G · 2 marketplaces: as marcas, em branco (paleta da página) -->
  <li class="placa holofote bloco bloco--foco" data-revelar>
    <span class="rotulo bloco__rotulo">{foco.rotulo}</span>
    <div class="apps">
      <span class="app" style="--i:0">
        <MarcaMercadoLivre class="app__ml" />
      </span>
      <span class="apps__elo" aria-hidden="true"></span>
      <span class="app" style="--i:1">
        <svg class="app__shopee" viewBox="0 0 24 24" role="img" aria-label="Shopee">
          <path d={siShopee.path}></path>
        </svg>
      </span>
    </div>
    <div class="bloco__base">
      <span class="numero bloco__numero" data-contar data-contar-atraso="380">
        {foco.numero}
      </span>
      <p class="bloco__texto">{foco.texto}: {foco.canais.join(' e ')}</p>
    </div>
  </li>
</ul>

<style>
  /* ---------- Grade ---------- */
  .bento {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    padding: 0;
    list-style: none;
  }

  .bloco {
    /* início das microanimações internas: logo depois que o bloco assenta */
    --d: calc(var(--lote, 0ms) + 380ms);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 18px;
    min-height: 196px;
    padding: 18px;
    transition:
      border-color var(--transicao),
      box-shadow 500ms ease,
      transform 600ms var(--saida);
    /* entrada: os blocos montam em cascata (ordem de importância) */
    animation: bento-entra 1000ms var(--saida) var(--lote, 0ms) backwards;
  }

  @keyframes bento-entra {
    from {
      opacity: 0;
      translate: 0 34px;
      scale: 0.94;
      filter: blur(10px);
    }
  }

  /* com overflow escondido, o anel do holofote fica por dentro da borda */
  .bloco.holofote::before {
    inset: 0;
  }

  .bloco--experiencia,
  .bloco--operacao,
  .bloco--aovivo {
    grid-column: span 2;
  }

  @media (hover: hover) {
    .bloco:hover {
      transform: translateY(-4px);
      border-color: color-mix(in oklab, var(--azul-fio) 45%, transparent);
      box-shadow:
        inset 0 1px 0 color-mix(in oklab, var(--offwhite) 12%, transparent),
        0 24px 48px -20px color-mix(in oklab, var(--azul) 60%, transparent);
    }
  }

  .bloco__topo {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .bloco__rotulo {
    position: relative;
    z-index: 1;
  }

  .bloco--operacao .bloco__rotulo {
    color: var(--offwhite);
    text-shadow: 0 1px 10px var(--navy-noite);
  }

  .bloco__base {
    position: relative;
    z-index: 1;
  }

  .bloco__numero {
    display: block;
    font-size: clamp(2.25rem, 1.8rem + 1.6vw, 3rem);
  }

  .bloco__titulo {
    font-size: 1.375rem;
    letter-spacing: -0.02em;
  }

  .bloco__titulo--menor {
    font-size: 1.125rem;
  }

  .bloco__texto {
    margin-top: 6px;
    font-size: var(--fs-pequeno);
    line-height: 1.45;
    color: var(--texto-suave);
  }

  /* ---------- A · experiência (acesa) ---------- */
  .bloco--experiencia {
    min-height: 340px;
    /* luz azul subindo do canto, cortada por um feixe a 67,5° (como o "88%" da referência) */
    background:
      linear-gradient(
        calc(var(--desvio-luz) + 90deg),
        transparent 52%,
        color-mix(in oklab, var(--azul-luz) 16%, transparent) 60%,
        transparent 68%
      ),
      radial-gradient(
        120% 90% at 10% 110%,
        color-mix(in oklab, var(--azul) 85%, transparent),
        color-mix(in oklab, var(--azul) 30%, transparent) 50%,
        transparent 80%
      ),
      var(--navy);
  }

  /* feixe a 67,5° que atravessa a placa acesa quando ela aparece */
  .bloco__feixe {
    position: absolute;
    inset: -10% -30%;
    pointer-events: none;
    background: linear-gradient(
      calc(var(--desvio-luz) + 90deg),
      transparent 40%,
      color-mix(in oklab, var(--azul-luz) 30%, transparent) 50%,
      transparent 60%
    );
    translate: -100% 0;
    animation: bento-feixe 1800ms var(--saida) var(--d) both;
  }

  @keyframes bento-feixe {
    to {
      translate: 100% 0;
    }
  }

  /* trajetória: a linha sobe em degraus de 45°, um marco por ano, até "hoje" */
  .trajetoria {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    max-width: 520px;
    height: auto;
    margin: auto 0;
    overflow: visible;
  }

  .trajetoria__stop-forte {
    stop-color: var(--azul-luz);
    stop-opacity: 0.4;
  }

  .trajetoria__stop-fraco {
    stop-color: var(--azul);
    stop-opacity: 0;
  }

  .trajetoria__stop-inicio {
    stop-color: var(--azul);
  }

  .trajetoria__stop-fim {
    stop-color: var(--offwhite);
  }

  .trajetoria__grade {
    stroke: color-mix(in oklab, var(--offwhite) 9%, transparent);
    stroke-width: 1;
    stroke-dasharray: 2 6;
  }

  .trajetoria__area {
    fill: url(#trajetoria-area);
    animation: mov-aparece 1200ms ease calc(var(--d) + 900ms) backwards;
  }

  .trajetoria__linha {
    fill: none;
    stroke: url(#trajetoria-linha);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    filter: drop-shadow(0 0 6px color-mix(in oklab, var(--azul-luz) 70%, transparent));
    transition: stroke-width 400ms ease;
    animation: bento-traco 1500ms cubic-bezier(0.6, 0, 0.3, 1) var(--d) backwards;
  }

  @keyframes bento-traco {
    from {
      stroke-dashoffset: 1;
    }
  }

  .trajetoria__marco {
    fill: var(--navy);
    stroke: var(--azul-luz);
    stroke-width: 2;
    transform-box: fill-box;
    transform-origin: center;
    transition: scale 400ms var(--mola);
    /* cada marco acende quando a linha passa por ele (acompanha a contagem 1, 2, 3…) */
    animation: bento-marco 600ms var(--mola) calc(var(--d) + var(--i) * 270ms) backwards;
  }

  .trajetoria__marco--hoje {
    fill: var(--offwhite);
    stroke: var(--offwhite);
  }

  @keyframes bento-marco {
    from {
      scale: 0;
    }
  }

  /* "hoje" pulsa: a operação segue ativa */
  .trajetoria__halo {
    fill: none;
    stroke: var(--azul-luz);
    stroke-width: 1.5;
    transform-box: fill-box;
    transform-origin: center;
    opacity: 0;
    animation: bento-halo 2.4s ease-out calc(var(--d) + 1500ms) infinite;
  }

  @keyframes bento-halo {
    0% {
      opacity: 0.9;
      scale: 1;
    }
    100% {
      opacity: 0;
      scale: 3.2;
    }
  }

  .trajetoria__legenda {
    font-family: var(--fonte-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    fill: var(--texto-suave);
  }

  .trajetoria__legenda--hoje {
    fill: var(--offwhite);
  }

  @media (hover: hover) {
    .bloco--experiencia:hover .trajetoria__linha {
      stroke-width: 3.5;
    }

    .bloco--experiencia:hover .trajetoria__marco {
      scale: 1.35;
      transition-delay: calc(var(--i) * 60ms);
    }
  }

  .bloco__gigante {
    display: block;
    font-size: clamp(4.5rem, 3rem + 6vw, 7.5rem);
    line-height: 0.9;
    letter-spacing: -0.06em;
    color: var(--offwhite);
    text-shadow: 0 0 40px color-mix(in oklab, var(--azul) 70%, transparent);
    /* o número respira devagar, como uma luz acesa */
    animation: bento-respira 4.5s ease-in-out var(--d) infinite alternate;
  }

  @keyframes bento-respira {
    to {
      text-shadow:
        0 0 64px color-mix(in oklab, var(--azul) 90%, transparent),
        0 0 18px color-mix(in oklab, var(--azul-luz) 50%, transparent);
    }
  }

  .bloco--experiencia .bloco__texto {
    max-width: 20rem;
    margin-top: 12px;
    font-size: var(--fs-corpo);
    color: color-mix(in oklab, var(--offwhite) 90%, var(--azul));
  }

  .bloco__faturamento {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid color-mix(in oklab, var(--offwhite) 20%, transparent);
    font-size: var(--fs-pequeno);
    color: color-mix(in oklab, var(--offwhite) 90%, var(--azul));
  }

  .bloco__faturamento span {
    display: block;
    margin-top: 4px;
    font-size: 0.75rem;
    color: var(--texto-suave);
  }

  /* ---------- B · operação (foto) ---------- */
  .bloco--operacao {
    min-height: 240px;
  }

  .bloco--operacao :global(.bloco__foto) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
    transition:
      scale 1600ms var(--saida),
      translate 1600ms var(--saida),
      opacity 600ms ease;
    animation: bento-foto 2400ms var(--saida) var(--lote, 0ms) backwards;
  }

  @keyframes bento-foto {
    from {
      scale: 1.2;
      opacity: 0;
    }
  }

  @media (hover: hover) {
    .bloco--operacao:hover :global(.bloco__foto) {
      scale: 1.08;
      translate: -2% 0;
      opacity: 1;
    }
  }

  /* degradê navy sobre a foto para o texto ler (brand book: "sobre foto, com faixa") */
  .bloco--operacao::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, color-mix(in oklab, var(--navy-noite) 85%, transparent), transparent 38%),
      linear-gradient(0deg, var(--navy-noite) 5%, color-mix(in oklab, var(--navy-noite) 70%, transparent) 40%, transparent 75%);
  }

  /* selo "em operação": ponto que pulsa como status online */
  .ao-vivo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 10px 5px 9px;
    border-radius: 999px;
    border: 1px solid color-mix(in oklab, var(--offwhite) 22%, transparent);
    background: color-mix(in oklab, var(--navy-noite) 65%, transparent);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    font-family: var(--fonte-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--offwhite);
    animation: mov-sobe 800ms var(--saida) var(--d) backwards;
  }

  .ao-vivo i,
  .bloco__rotulo--vivo::before {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--azul-luz);
    animation: bento-ao-vivo 2.4s ease-out var(--d) infinite;
  }

  @keyframes bento-ao-vivo {
    0% {
      box-shadow: 0 0 0 0 color-mix(in oklab, var(--azul-luz) 70%, transparent);
    }
    70%,
    100% {
      box-shadow: 0 0 0 7px transparent;
    }
  }

  /* ---------- C · atuação ---------- */
  .atuacao {
    display: grid;
    padding: 0;
    list-style: none;
    font-size: 0.8125rem;
    color: var(--texto-suave);
  }

  .atuacao li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 0;
    border-bottom: 1px solid color-mix(in oklab, var(--offwhite) 9%, transparent);
    transition: color 400ms ease;
    animation: bento-item 800ms var(--saida) calc(var(--d) + var(--i) * 120ms) backwards;
  }

  @keyframes bento-item {
    from {
      opacity: 0;
      translate: -16px 0;
    }
  }

  .atuacao__icone {
    display: grid;
    place-items: center;
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: color-mix(in oklab, var(--azul) 16%, transparent);
    color: var(--azul-fio);
    transition:
      background-color 400ms ease,
      color 400ms ease,
      scale 400ms var(--mola);
    animation: bento-icone 700ms var(--mola) calc(var(--d) + 80ms + var(--i) * 120ms) backwards;
  }


---
// Cabeçalho: só o símbolo MZ (a assinatura completa exige ≥ 280 px, então fica no rodapé).
import Simbolo from '../assets/logos/simbolo-transparente-p-fundo-escuro.svg';
import BotaoWhatsApp from './ui/BotaoWhatsApp.astro';
---

<header class="cabecalho">
  <div class="container cabecalho__linha">
    <a class="cabecalho__marca" href="/" aria-label="Marcelo Zotti, página inicial">
      <Simbolo class="cabecalho__simbolo" aria-hidden="true" />
    </a>
    <BotaoWhatsApp origem="cabecalho" variante="contorno">Falar no WhatsApp</BotaoWhatsApp>
  </div>
</header>

<style>
  .cabecalho {
    position: absolute;
    inset: 0 0 auto;
    z-index: 10;
    padding-top: 12px;
  }

  .cabecalho__linha {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .cabecalho__marca {
    display: block;
    /* o SVG já inclui a área de proteção em volta do desenho (≈ 7,7% da largura);
       a margem negativa compensa isso e alinha o desenho com o texto da página */
    margin-left: -8px;
  }

  .cabecalho__simbolo {
    width: 104px; /* desenho ≈ 88 px, acima do mínimo de 64 px do brand book */
    height: auto;
  }

  /* entra junto com o hero: desce do escuro logo depois do feixe acender */
  .cabecalho__marca,
  .cabecalho__linha > :global(.botao) {
    animation: cabecalho-entra 900ms cubic-bezier(0.16, 1, 0.3, 1) 120ms backwards;
  }

  .cabecalho__linha > :global(.botao) {
    animation-delay: 300ms;
  }

  @keyframes cabecalho-entra {
    from {
      opacity: 0;
      translate: 0 -14px;
      filter: blur(6px);
    }
  }

  @media (min-width: 1024px) {
    .cabecalho {
      padding-top: 20px;
    }

    .cabecalho__marca {
      margin-left: -10px;
    }

    .cabecalho__simbolo {
      width: 128px;
    }
  }
</style>
